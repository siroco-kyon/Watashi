<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="AssemblyName;OutputType">

  <PropertyGroup>
    <!-- VS 発行時のプロパティ汚染を防ぐ。詳細は Watashi.Shared.csproj のコメント。 -->
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Watashi.Shared\Watashi.Shared.csproj" />
    <ProjectReference Include="..\..\src\Watashi.Server\Watashi.Server.csproj" />
    <ProjectReference Include="..\..\src\Watashi.Agent\Watashi.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF へ依存しないクライアント認証サービスを同じソースから回帰テストする。 -->
    <Compile Include="..\..\src\Watashi.Client\Services\ApiException.cs" Link="Client\ApiException.cs" />
    <Compile Include="..\..\src\Watashi.Client\Services\ApiClient.cs" Link="Client\ApiClient.cs" />
    <Compile Include="..\..\src\Watashi.Client\Services\AppSettings.cs" Link="Client\AppSettings.cs" />
    <Compile Include="..\..\src\Watashi.Client\Services\Brand.cs" Link="Client\Brand.cs" />
    <Compile Include="..\..\src\Watashi.Client\Services\ProgressStreamContent.cs" Link="Client\ProgressStreamContent.cs" />
    <Compile Include="..\..\src\Watashi.Client\Services\SessionManager.cs" Link="Client\SessionManager.cs" />
  </ItemGroup>

</Project>
