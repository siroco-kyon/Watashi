<?xml version="1.0" encoding="utf-8"?>
<!--
  https://aka.ms/clickonce-publishing
  発行: VS 付属の MSBuild.exe で実行 (dotnet publish は UpdateManifest 非対応 = MSB4803 で失敗):
        MSBuild.exe src\Watashi.Client\Watashi.Client.csproj /t:Publish /p:Configuration=Release /p:PublishProfile=ClickOnceProfile
        詳細は deploy/README.md「2. ClickOnce クライアント」参照。
  証明書: 社内 CA 発行の Code Signing 証明書を ManifestCertificateThumbprint で指定すること。

  接続先サーバ・D&D の配布設定:
    src\Watashi.Client\deployment.json を編集してから発行する。
      - serverUrl      : 接続する中央サーバ (例 https://watashi.internal)
      - enableDragDrop : ドラッグ＆ドロップ転送の可否 (true/false)
    これらは利用者が変更できず、deployment.json が唯一の真実。
    ClickOnce はマニフェストでファイルのハッシュを検証するため、
    値を変えたら必ず再発行 (このコマンドを再実行) して再署名すること。
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish\</PublishDir>
    <PublishUrl>\\fileserver\share\Watashi\</PublishUrl>
    <InstallUrl>https://watashi.internal/install/</InstallUrl>
    <UpdateUrl>https://watashi.internal/install/</UpdateUrl>
    <!-- 起動毎の更新チェックを必須化:
           UpdateMode=Foreground   … ショートカット (.appref-ms) 起動のたびに、起動前へ更新チェック
           UpdateRequired=true +
           MinimumRequiredVersion=発行バージョン
                                   … 新版が見つかったら「スキップ」不可で自動適用してから起動
         注意: bin 配下の Watashi.Client.exe を直接起動した場合はチェックされない。
               利用者にはスタートメニュー / デスクトップの「Watashi」から起動させること。 -->
    <UpdateRequired>true</UpdateRequired>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <!-- 発行時刻ベースのバージョン。1 箇所で評価し ApplicationVersion と
         MinimumRequiredVersion のズレ (分境界をまたぐ二重評価) を防ぐ -->
    <WatashiPublishVersion>1.$([System.DateTime]::UtcNow.ToString('yy')).$([System.DateTime]::UtcNow.ToString('MMdd')).$([System.DateTime]::UtcNow.ToString('HHmm'))</WatashiPublishVersion>
    <ApplicationVersion>$(WatashiPublishVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <MinimumRequiredVersion>$(WatashiPublishVersion)</MinimumRequiredVersion>
    <Install>true</Install>
    <SignManifests>true</SignManifests>
    <!-- 社内 CA で発行した署名証明書のサムプリントを設定 -->
    <ManifestCertificateThumbprint></ManifestCertificateThumbprint>
    <ManifestKeyFile></ManifestKeyFile>
    <GenerateManifests>true</GenerateManifests>
    <ProductName>Watashi</ProductName>
    <PublisherName>Watashi</PublisherName>
    <SuiteName>Watashi</SuiteName>
    <!-- ClickOnce のインストーラ画面・配信マニフェスト・Add/Remove Programs のアイコン。
         実体は src/Watashi.Client/Watashi.ico。 -->
    <ApplicationIcon>Watashi.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
