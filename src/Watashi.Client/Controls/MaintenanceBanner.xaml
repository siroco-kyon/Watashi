<UserControl x:Class="Watashi.Client.Controls.MaintenanceBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource AccessibleWarningBanner}" Padding="14,10"
            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
        <StackPanel>
            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding ScheduleLabel}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding CheckedAtLabel}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                <Button Content="状況を再確認" Click="OnRefresh" Margin="0,0,6,4"
                        AutomationProperties.Name="メンテナンスの状況を再確認"/>
                <Button Content="案内ページ" Click="OnOpenPage" Margin="0,0,6,4"
                        Visibility="{Binding HasStatusPage, Converter={StaticResource BoolToVis}}"/>
                <Button Content="更新を確認" Click="OnCheckUpdate" Margin="0,0,0,4"
                        Visibility="{Binding RequiresUpdate, Converter={StaticResource BoolToVis}}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
