<UserControl x:Class="Watashi.Client.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework"
             x:Name="Root"
             Focusable="True"
             IsTabStop="False"
             KeyboardNavigation.TabNavigation="Local"
             AutomationProperties.Name="パスワード"
             AutomationProperties.HelpText="パスワード入力。Alt+P で表示と非表示を切り替えます。"
             GotKeyboardFocus="OnRootGotKeyboardFocus"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 非表示モード (デフォルト): PasswordBox -->
        <PasswordBox x:Name="PartPasswordBox"
                     Grid.Column="0"
                     Padding="8,5,42,5"
                     TabIndex="0"
                     AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Root}"
                     AutomationProperties.HelpText="{Binding Path=(AutomationProperties.HelpText), ElementName=Root}"
                     PasswordChanged="OnPasswordBoxChanged"
                     Visibility="{Binding IsRevealed, ElementName=Root, Converter={StaticResource BoolToVisInverted}}"/>

        <!-- 表示モード: TextBox -->
        <TextBox x:Name="PartTextBox"
                 Grid.Column="0"
                 Padding="8,5,42,5"
                 TabIndex="0"
                 AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), ElementName=Root}"
                 AutomationProperties.HelpText="パスワードを表示しています。入力内容が周囲から見えないことを確認してください。"
                 TextChanged="OnTextBoxChanged"
                 Visibility="{Binding IsRevealed, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

        <!-- 目玉トグルボタン (TextBox/PasswordBox の右端に重ねる) -->
        <ToggleButton x:Name="PartToggle"
                      Grid.Column="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="34" Height="30"
                      Margin="0,0,3,0"
                      Cursor="Hand"
                      Background="Transparent"
                      BorderThickness="1"
                      Focusable="True"
                      IsTabStop="True"
                      TabIndex="1"
                      FocusVisualStyle="{StaticResource AccessibleFocusVisual}"
                      AutomationProperties.Name="パスワードの表示切り替え"
                      AutomationProperties.HelpText="Space または Alt+P でパスワードの表示と非表示を切り替えます。"
                      IsChecked="{Binding IsRevealed, ElementName=Root, Mode=TwoWay}"
                      ToolTip="パスワードの表示/非表示を切り替え (Alt+P)">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <Image x:Name="Ico"
                                   Source="{StaticResource EyeIcon}"
                                   Width="18" Height="18"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="HighContrastLabel"
                                       Text="PW"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource {x:Static wpf:SystemColors.ControlTextBrushKey}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ico" Property="Source" Value="{StaticResource EyeOffIcon}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static wpf:SystemColors.HighlightBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static wpf:SystemParameters.HighContrast}}" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource {x:Static wpf:SystemColors.ControlBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{DynamicResource {x:Static wpf:SystemColors.ControlTextBrushKey}}"/>
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="HighContrastLabel" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
