<UserControl x:Class="Watashi.Client.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 非表示モード (デフォルト): PasswordBox -->
        <PasswordBox x:Name="PartPasswordBox"
                     Grid.Column="0"
                     Padding="8,5,36,5"
                     PasswordChanged="OnPasswordBoxChanged"
                     Visibility="{Binding IsRevealed, ElementName=Root, Converter={StaticResource BoolToVisInverted}}"/>

        <!-- 表示モード: TextBox -->
        <TextBox x:Name="PartTextBox"
                 Grid.Column="0"
                 Padding="8,5,36,5"
                 TextChanged="OnTextBoxChanged"
                 Visibility="{Binding IsRevealed, ElementName=Root, Converter={StaticResource BoolToVis}}"/>

        <!-- 目玉トグルボタン (TextBox/PasswordBox の右端に重ねる) -->
        <ToggleButton x:Name="PartToggle"
                      Grid.Column="0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="28" Height="28"
                      Margin="0,0,3,0"
                      Cursor="Hand"
                      Background="Transparent"
                      BorderThickness="0"
                      Focusable="False"
                      IsChecked="{Binding IsRevealed, ElementName=Root, Mode=TwoWay}"
                      ToolTip="パスワードの表示/非表示を切り替え (Alt+P)">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <Image x:Name="Ico"
                               Source="{StaticResource EyeIcon}"
                               Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ico" Property="Source" Value="{StaticResource EyeOffIcon}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</UserControl>
