<Application x:Class="Watashi.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Watashi.Client.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:UtcToLocalConverter x:Key="Utc"/>
        <conv:SizeFormatConverter x:Key="SizeFmt"/>
        <conv:ProtocolToBoolConverter x:Key="ProtocolToBool"/>
        <conv:NotBoolConverter x:Key="NotBool"/>
    </Application.Resources>
</Application>
