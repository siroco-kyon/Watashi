<Application x:Class="Watashi.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Watashi.Client.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    先頭は配色 (Color 値のみ)。起動時と切替時に Services/ThemeManager.cs が
                    Colors.Light.xaml / Colors.Dark.xaml を差し替える。
                    Colors.xaml のブラシがこの値を DynamicResource で引くため、
                    差し替えるだけで全画面の色が追従する。
                -->
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
            <conv:UtcToLocalConverter x:Key="Utc"/>
            <conv:SizeFormatConverter x:Key="SizeFmt"/>
            <conv:NotBoolConverter x:Key="NotBool"/>
            <conv:TypeToIconConverter x:Key="TypeIcon"/>
            <conv:StatusMessageToBrushConverter x:Key="StatusBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
