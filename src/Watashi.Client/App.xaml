<Application x:Class="Watashi.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Watashi.Client.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
            <conv:UtcToLocalConverter x:Key="Utc"/>
            <conv:SizeFormatConverter x:Key="SizeFmt"/>
            <conv:NotBoolConverter x:Key="NotBool"/>
            <conv:TypeToIconConverter x:Key="TypeIcon"/>
            <conv:FileEntryVisualCategoryConverter x:Key="FileEntryVisualCategory"/>
            <conv:FileExtensionTextConverter x:Key="ExtText"/>
            <conv:FileEntryColorBrushConverter x:Key="FileEntryColorBrush"/>
            <conv:FileColorKeyToBrushConverter x:Key="FileColorKeyBrush"/>
            <conv:StatusMessageToBrushConverter x:Key="StatusBrush"/>
            <conv:DiagnosticStatusToLabelConverter x:Key="DiagnosticStatusLabel"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
