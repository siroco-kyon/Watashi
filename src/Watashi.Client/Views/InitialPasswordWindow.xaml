<Window x:Class="Watashi.Client.Views.InitialPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Watashi.Client.Controls"
        Title="Watashi - 初回パスワード設定"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">
    <Border Margin="20" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="初回パスワードの設定" Style="{StaticResource H2}" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,0,0,4">
                <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text=" さん、ようこそ。ご本人であることを Windows のログオン情報で確認しました。"/>
                <LineBreak/>
                <Run Text="これから使うパスワードをご自身で決めてください。"/>
            </TextBlock>

            <TextBlock Text="{Binding DeadlineMessage}"
                       Foreground="{StaticResource WarningBrush}"
                       Visibility="{Binding HasDeadline, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="新しいパスワード" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
            <ctl:PasswordRevealBox x:Name="NewP"
                                   Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="12文字以上 / 英大・英小・数字・記号 を各1文字以上"/>

            <TextBlock Text="新しいパスワード (確認)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="Confirm"
                                   Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Margin="0,0,0,8"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" MinHeight="22" Margin="0,4,0,4"/>

            <Button Content="設定してログイン" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SubmitCommand}" Height="36"
                    IsDefault="True"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                    Margin="0,8,0,0"/>

            <Button Content="キャンセル" Height="36" IsCancel="True" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
