<Window x:Class="Watashi.Client.Views.RemoteTrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リモートごみ箱" Width="980" Height="600" MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner" Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="リモートごみ箱">
    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="リモートごみ箱" Style="{StaticResource H2}"/>
                    <TextBlock Text="削除した項目は保管期限まで復元できます。上書きと完全削除は管理者だけが実行できます。"
                               Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="再読み込み" Command="{Binding RefreshCommand}"
                        Style="{StaticResource GhostButton}" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="前へ" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPrevious}"/>
                    <Button Content="次へ" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNext}" Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding RangeText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text=" / 使用量 " VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource SizeFmt}}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="16,0"
                           Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox Width="150" ItemsSource="{Binding CollisionOptions}"
                              SelectedItem="{Binding SelectedCollisionPolicy}" DisplayMemberPath="Label"
                              ToolTip="同名項目がある場合の復元方法"/>
                    <Button Content="復元" Click="OnRestore" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding HasSelection}" Margin="8,0,0,0"/>
                    <Button Content="完全削除" Click="OnPurge" Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding HasSelection}" Margin="8,0,0,0"/>
                    <Button Content="閉じる" IsCancel="True" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0"
                      AutomationProperties.Name="ごみ箱項目一覧">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="180"/>
                        <GridViewColumn Header="元のパス" DisplayMemberBinding="{Binding OriginalPath}" Width="290"/>
                        <GridViewColumn Header="種別" DisplayMemberBinding="{Binding ItemType}" Width="80"/>
                        <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding SizeBytes, Converter={StaticResource SizeFmt}}" Width="100"/>
                        <GridViewColumn Header="削除者" DisplayMemberBinding="{Binding DeletedByUsername}" Width="120"/>
                        <GridViewColumn Header="削除日時" DisplayMemberBinding="{Binding DeletedAt, Converter={StaticResource Utc}}" Width="145"/>
                        <GridViewColumn Header="期限" DisplayMemberBinding="{Binding ExpiresAt, Converter={StaticResource Utc}}" Width="145"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
