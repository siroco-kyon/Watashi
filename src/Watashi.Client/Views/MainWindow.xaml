<Window x:Class="Watashi.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watashi - ファイル管理" Width="1180" Height="740" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- メニュー -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="再読み込み" Click="OnRefresh" InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="ログアウト" Click="OnLogout"/>
                <MenuItem Header="終了" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="管理(_A)" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Click="OnOpenAdmin"/>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="バージョン情報" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- 主要操作ツールバー（上部） -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="{Binding UploadCommand}" Padding="10,4" ToolTip="ローカルで選択中のファイルをリモートへアップロード">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="アップロード"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DownloadCommand}" Padding="10,4" ToolTip="リモートで選択中のファイルをローカルへダウンロード">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="ダウンロード"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="OnNewRemoteFolder" Padding="8,4" ToolTip="リモートに新規フォルダを作成">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁+" Margin="0,0,4,0"/>
                        <TextBlock Text="新規フォルダ (リモート)"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Local.NewFolderCommand}" Padding="8,4" ToolTip="ローカルに新規フォルダを作成">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁+" Margin="0,0,4,0"/>
                        <TextBlock Text="新規フォルダ (ローカル)"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding Remote.DeleteSelectedCommand}" Padding="8,4" Foreground="#B22222">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,4,0"/>
                        <TextBlock Text="リモート削除"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Local.DeleteSelectedCommand}" Padding="8,4" Foreground="#B22222">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,4,0"/>
                        <TextBlock Text="ローカル削除"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 下: ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Local.StatusMessage}" Foreground="#666"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Remote.StatusMessage}" Foreground="#666"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="{Binding ProtocolLabel, StringFormat=接続: {0}}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="{Binding Username, StringFormat=ユーザー: {0}}"/></StatusBarItem>
        </StatusBar>

        <!-- 下: 転送進捗 -->
        <Grid DockPanel.Dock="Bottom" Margin="6" Visibility="{Binding Transfer.IsActive, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0" Minimum="0" Maximum="{Binding Transfer.TotalBytes}" Value="{Binding Transfer.BytesTransferred}" Height="18"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <Run Text="{Binding Transfer.FileName, Mode=OneWay}"/> <Run Text="{Binding Transfer.Percent, StringFormat={}{0}%, Mode=OneWay}"/>
            </TextBlock>
        </Grid>

        <!-- 2 ペイン -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ローカルペイン -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="#F5F5F5" Padding="6,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                    <TextBlock Text="ローカル" FontWeight="Bold" Foreground="#444"/>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="4">
                    <Button Content="◀" Command="{Binding Local.GoBackCommand}" IsEnabled="{Binding Local.CanGoBack}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="戻る (Alt+←)"/>
                    <Button Content="▶" Command="{Binding Local.GoForwardCommand}" IsEnabled="{Binding Local.CanGoForward}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="進む (Alt+→)"/>
                    <Button Content="⬆" Command="{Binding Local.GoUpCommand}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="親フォルダへ (Alt+↑ / BackSpace)"/>
                    <Button Content="⟳" Command="{Binding Local.RefreshCommand}"
                            Width="28" Height="26" Margin="0,0,6,0" ToolTip="再読み込み (F5)"/>
                    <Button Content="移動" Click="OnLocalGo" DockPanel.Dock="Right"
                            Width="60" Height="26" Margin="4,0,0,0"/>
                    <TextBox Name="LocalPathBox" Text="{Binding Local.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnLocalPathKeyDown" Height="26" VerticalContentAlignment="Center"/>
                </DockPanel>
                <ListView ItemsSource="{Binding Local.Entries}" SelectedItem="{Binding Local.Selected}"
                          MouseDoubleClick="OnLocalDoubleClick" KeyDown="OnLocalListKeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource TypeIcon}}" FontSize="16" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="260"/>
                            <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding Size, Converter={StaticResource SizeFmt}}" Width="90"/>
                            <GridViewColumn Header="更新" DisplayMemberBinding="{Binding ModifiedAt, Converter={StaticResource Utc}}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E8E8E8"/>

            <!-- リモートペイン -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#EEF5FF" Padding="6,4" BorderBrush="#CCDDEE" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="リモート" FontWeight="Bold" Foreground="#1A4F8B" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <TextBlock Text=" / 場所:" Margin="8,0,4,0" Foreground="#666" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Remote.Locations}" SelectedItem="{Binding Remote.SelectedLocation}"
                                  DisplayMemberPath="DisplayName" Width="220" Height="22"/>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="4">
                    <Button Content="◀" Command="{Binding Remote.GoBackCommand}" IsEnabled="{Binding Remote.CanGoBack}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="戻る (Alt+←)"/>
                    <Button Content="▶" Command="{Binding Remote.GoForwardCommand}" IsEnabled="{Binding Remote.CanGoForward}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="進む (Alt+→)"/>
                    <Button Content="⬆" Command="{Binding Remote.GoUpCommand}" IsEnabled="{Binding Remote.CanGoUp}"
                            Width="28" Height="26" Margin="0,0,2,0" ToolTip="親フォルダへ (Alt+↑ / BackSpace)"/>
                    <Button Content="⟳" Command="{Binding Remote.RefreshCommand}"
                            Width="28" Height="26" Margin="0,0,6,0" ToolTip="再読み込み (F5)"/>
                    <Button Content="移動" Click="OnRemoteGo" DockPanel.Dock="Right"
                            Width="60" Height="26" Margin="4,0,0,0"/>
                    <TextBox Name="RemotePathBox" Text="{Binding Remote.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnRemotePathKeyDown" Height="26" VerticalContentAlignment="Center"/>
                </DockPanel>
                <ListView ItemsSource="{Binding Remote.Entries}" SelectedItem="{Binding Remote.Selected}"
                          MouseDoubleClick="OnRemoteDoubleClick" KeyDown="OnRemoteListKeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource TypeIcon}}" FontSize="16" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="260"/>
                            <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding Size, Converter={StaticResource SizeFmt}}" Width="90"/>
                            <GridViewColumn Header="更新" DisplayMemberBinding="{Binding ModifiedAt, Converter={StaticResource Utc}}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
