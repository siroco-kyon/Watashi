<Window x:Class="Watashi.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watashi"
        Width="1200" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource ToriiIcon}" Width="26" Height="26" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Watashi" Style="{StaticResource H3}"/>
                        <TextBlock Text="CIFS ファイル管理" Style="{StaticResource Caption}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: user + actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="10,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                            <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ProtocolLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="管理"
                            Click="OnOpenAdmin"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                            ToolTip="管理画面を開く"/>

                    <Button Style="{StaticResource IconButton}" Click="OnRefresh" ToolTip="再読み込み (F5)">
                        <TextBlock Text="⟳" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnLogout" ToolTip="ログアウト">
                        <TextBlock Text="⏻" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnAbout" ToolTip="バージョン情報">
                        <TextBlock Text="ⓘ" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Action Toolbar ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding UploadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        ToolTip="ローカルで選択中のファイルをリモートへアップロード">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="アップロード"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DownloadCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,16,0"
                        ToolTip="リモートで選択中のファイルをローカルへダウンロード">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬇" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="ダウンロード"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,4,12,4"/>

                <Button Click="OnNewRemoteFolder" Margin="0,0,6,0" ToolTip="リモートに新規フォルダを作成">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁＋" Margin="0,0,6,0"/>
                        <TextBlock Text="新規フォルダ (リモート)"/>
                    </StackPanel>
                </Button>
                <Button Click="OnNewLocalFolder" Margin="0,0,16,0" ToolTip="ローカルに新規フォルダを作成">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁＋" Margin="0,0,6,0"/>
                        <TextBlock Text="新規フォルダ (ローカル)"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,4,12,4"/>

                <Button Click="OnRemoteDelete" Style="{StaticResource DangerButton}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,6,0"/>
                        <TextBlock Text="リモート削除"/>
                    </StackPanel>
                </Button>
                <Button Click="OnLocalDelete" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,6,0"/>
                        <TextBlock Text="ローカル削除"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===== Status Bar ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ProtocolLabel, StringFormat=接続中 ({0})}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentDeepBrush}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Local.StatusMessage}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="{Binding Remote.StatusMessage}"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding Username, StringFormat=ユーザー: {0}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== Transfer progress ===== -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,8"
                Visibility="{Binding Transfer.IsActive, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="転送中:"/> <Run Text="{Binding Transfer.FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <ProgressBar Minimum="0"
                                 Maximum="{Binding Transfer.TotalBytes}"
                                 Value="{Binding Transfer.BytesTransferred}"
                                 Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
                    <Run Text="{Binding Transfer.Percent, Mode=OneWay}"/><Run Text="%"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ===== Two Panes ===== -->
        <Grid Margin="18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Local pane -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="ローカル" Style="{StaticResource H3}"/>
                            <TextBlock Text="(このPC)" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                        <Button Style="{StaticResource IconButton}" Command="{Binding Local.GoBackCommand}"
                                IsEnabled="{Binding Local.CanGoBack}" ToolTip="戻る (Alt+←)" Margin="0,0,2,0">
                            <TextBlock Text="◀" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Local.GoForwardCommand}"
                                IsEnabled="{Binding Local.CanGoForward}" ToolTip="進む (Alt+→)" Margin="0,0,2,0">
                            <TextBlock Text="▶" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Local.GoUpCommand}"
                                ToolTip="親フォルダへ (Alt+↑ / BackSpace)" Margin="0,0,2,0">
                            <TextBlock Text="⬆" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Local.RefreshCommand}"
                                ToolTip="再読み込み (F5)" Margin="0,0,8,0">
                            <TextBlock Text="⟳" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="OnLocalGo" Content="移動" Margin="6,0,0,0" MinWidth="60"/>
                        <Button DockPanel.Dock="Right" Click="OnLocalBrowse" Margin="6,0,0,0" MinWidth="40"
                                ToolTip="フォルダを参照 (エクスプローラ風のフォルダ選択ダイアログを開く)">
                            <TextBlock Text="📂"/>
                        </Button>
                        <TextBox Name="LocalPathBox"
                                 Text="{Binding Local.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnLocalPathKeyDown"/>
                    </DockPanel>

                    <ListView ItemsSource="{Binding Local.Entries}"
                              SelectedItem="{Binding Local.Selected}"
                              MouseDoubleClick="OnLocalDoubleClick"
                              KeyDown="OnLocalListKeyDown"
                              BorderThickness="0,1,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource TypeIcon}}" FontSize="15" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="名前" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding Size, Converter={StaticResource SizeFmt}}" Width="90"/>
                                <GridViewColumn Header="更新" DisplayMemberBinding="{Binding ModifiedAt, Converter={StaticResource Utc}}" Width="160"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="14" Background="Transparent"/>

            <!-- Remote pane -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0"
                            Background="{StaticResource AccentSoftBrush}">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="⛩" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="リモート" Style="{StaticResource H3}" Foreground="{StaticResource AccentDeepBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="場所:" Style="{StaticResource Caption}" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding Remote.Locations}" SelectedItem="{Binding Remote.SelectedLocation}"
                                          DisplayMemberPath="DisplayName" Width="240"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                        <Button Style="{StaticResource IconButton}" Command="{Binding Remote.GoBackCommand}"
                                IsEnabled="{Binding Remote.CanGoBack}" ToolTip="戻る (Alt+←)" Margin="0,0,2,0">
                            <TextBlock Text="◀" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Remote.GoForwardCommand}"
                                IsEnabled="{Binding Remote.CanGoForward}" ToolTip="進む (Alt+→)" Margin="0,0,2,0">
                            <TextBlock Text="▶" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Remote.GoUpCommand}"
                                IsEnabled="{Binding Remote.CanGoUp}" ToolTip="親フォルダへ (Alt+↑ / BackSpace)" Margin="0,0,2,0">
                            <TextBlock Text="⬆" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding Remote.RefreshCommand}"
                                ToolTip="再読み込み (F5)" Margin="0,0,8,0">
                            <TextBlock Text="⟳" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Click="OnRemoteGo" Content="移動" Margin="6,0,0,0" MinWidth="60"
                                IsEnabled="{Binding Remote.HasLocation}"/>
                        <TextBox Name="RemotePathBox"
                                 Text="{Binding Remote.CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnRemotePathKeyDown"
                                 IsEnabled="{Binding Remote.HasLocation}"/>
                    </DockPanel>

                    <Grid>
                        <ListView ItemsSource="{Binding Remote.Entries}"
                                  SelectedItem="{Binding Remote.Selected}"
                                  MouseDoubleClick="OnRemoteDoubleClick"
                                  KeyDown="OnRemoteListKeyDown"
                                  BorderThickness="0,1,0,0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type, Converter={StaticResource TypeIcon}}" FontSize="15" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="260"/>
                                    <GridViewColumn Header="サイズ" DisplayMemberBinding="{Binding Size, Converter={StaticResource SizeFmt}}" Width="90"/>
                                    <GridViewColumn Header="更新" DisplayMemberBinding="{Binding ModifiedAt, Converter={StaticResource Utc}}" Width="160"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- Empty state: no locations granted -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Remote.HasNoLocations, Converter={StaticResource BoolToVis}}"
                                    Margin="20" IsHitTestVisible="False">
                            <TextBlock Text="⛩" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="アクセスできるリモート場所がありません"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="管理者にユーザー権限の追加を依頼してください"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                                       MaxWidth="300"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
