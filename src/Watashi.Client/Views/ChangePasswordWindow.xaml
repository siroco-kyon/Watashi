<Window x:Class="Watashi.Client.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パスワード変更" Width="420" Height="380" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="⚠ パスワード変更が必要です" Foreground="DarkOrange" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="現在のパスワード"/>
        <PasswordBox x:Name="Current" Grid.Row="2" PasswordChanged="OnCurrentChanged" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="3" Text="新しいパスワード"/>
        <PasswordBox x:Name="NewP" Grid.Row="4" PasswordChanged="OnNewChanged" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="5" Text="新しいパスワード (確認)"/>
        <PasswordBox x:Name="Confirm" Grid.Row="6" PasswordChanged="OnConfirmChanged" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="7" Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap"/>
        <Button Grid.Row="8" Content="変更" Command="{Binding ChangeCommand}" Height="32" Margin="0,8,0,0" IsDefault="True"/>
    </Grid>
</Window>
