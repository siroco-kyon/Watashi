<Window x:Class="Watashi.Client.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Watashi.Client.Controls"
        Title="パスワード変更"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">
    <Border Margin="20" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="パスワード変更" Style="{StaticResource H2}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding HeaderMessage}"
                       Foreground="{StaticResource WarningBrush}" Margin="0,0,0,14"/>

            <TextBlock Text="現在のパスワード" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="Current"
                                   Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Margin="0,0,0,10"/>

            <TextBlock Text="新しいパスワード" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="NewP"
                                   Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="12文字以上 / 英大・英小・数字・記号 を各1文字以上"/>

            <TextBlock Text="新しいパスワード (確認)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="Confirm"
                                   Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   Margin="0,0,0,8"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" MinHeight="22" Margin="0,4,0,4"/>

            <Button Content="変更" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ChangeCommand}" Height="36"
                    IsDefault="True" Margin="0,8,0,0"/>

            <!-- 任意変更のときだけ表示し、Esc / クリックで DialogResult=false で閉じる。 -->
            <Button Content="キャンセル" Height="36"
                    IsCancel="{Binding CanCancel}" Margin="0,8,0,0"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Border>
</Window>
