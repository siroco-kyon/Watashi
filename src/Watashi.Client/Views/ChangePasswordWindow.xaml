<Window x:Class="Watashi.Client.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Watashi.Client.Controls"
        Title="パスワード変更"
        Width="460" MaxHeight="760" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="パスワード変更">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border Margin="20" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="パスワード変更" Style="{StaticResource H2}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding HeaderMessage}"
                       Style="{StaticResource AccessibleWarningText}" Margin="0,0,0,14"/>

            <Label Content="現在のパスワード" Target="{Binding ElementName=Current}"
                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="Current"
                                   Password="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   AutomationProperties.Name="現在のパスワード"
                                   Margin="0,0,0,10"/>

            <Label Content="新しいパスワード" Target="{Binding ElementName=NewP}"
                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="NewP"
                                   Password="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   AutomationProperties.Name="新しいパスワード"
                                   AutomationProperties.HelpText="12文字以上で、英大文字・英小文字・数字・記号を含めます。"
                                   Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="12文字以上 / 英大・英小・数字・記号 を各1文字以上"/>

            <Label Content="新しいパスワード (確認)" Target="{Binding ElementName=Confirm}"
                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ctl:PasswordRevealBox x:Name="Confirm"
                                   Password="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                   AutomationProperties.Name="新しいパスワードの確認"
                                   Margin="0,0,0,8"/>

            <TextBlock x:Name="PasswordChangeStatusLiveRegion"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource AccessibleErrorText}"
                       AutomationProperties.Name="{Binding StatusMessage, StringFormat=パスワード変更状態: {0}}"
                       AutomationProperties.LiveSetting="Assertive"
                       TextWrapping="Wrap" MinHeight="22" Margin="0,4,0,4"/>

            <Button Content="変更" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ChangeCommand}" Height="36"
                    IsDefault="True" Margin="0,8,0,0"/>

            <!-- 任意変更のときだけ表示し、Esc / クリックで DialogResult=false で閉じる。 -->
            <Button Content="キャンセル" Height="36"
                    IsCancel="{Binding CanCancel}" Margin="0,8,0,0"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
