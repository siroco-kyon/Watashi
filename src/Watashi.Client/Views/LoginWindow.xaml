<Window x:Class="Watashi.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Watashi.Client.Controls"
        Title="Watashi - ログイン"
        Width="440" Height="500" MinWidth="400" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">

    <Grid>
        <!-- 上部の朱色アクセントバー -->
        <Rectangle VerticalAlignment="Top" Height="6" Fill="{StaticResource AccentBrush}"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Margin="0,30,0,0">

            <!-- Logo -->
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Image Source="{StaticResource ToriiIcon}" Width="56" Height="56"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Watashi" Style="{StaticResource H1}"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="社内 CIFS ファイル管理"
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Login card -->
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="ユーザー名" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <!-- 2 段目。ID を確定するまではパスワードを訊かない。初回設定待ちのユーザーには
                         そもそもパスワードが無いため、先に ID で判定する必要がある。 -->
                    <StackPanel Visibility="{Binding IsPasswordStep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="パスワード" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ctl:PasswordRevealBox x:Name="PasswordBox"
                                               Password="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                               Margin="0,0,0,10"/>
                    </StackPanel>

                    <CheckBox Content="このPCを記憶する"
                              IsChecked="{Binding RememberDevice}"
                              IsEnabled="{Binding CanRemember}"
                              ToolTip="{Binding RememberTooltip}"
                              Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" MinHeight="20" Margin="0,4,0,4"/>

                    <Button Content="次へ"
                            Command="{Binding ContinueCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            FontWeight="SemiBold"
                            IsDefault="{Binding IsEnteringUsername}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                            Visibility="{Binding IsEnteringUsername, Converter={StaticResource BoolToVis}}"
                            Margin="0,6,0,0"/>

                    <Button Content="ログイン"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            FontWeight="SemiBold"
                            IsDefault="{Binding IsPasswordStep}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                            Visibility="{Binding IsPasswordStep, Converter={StaticResource BoolToVis}}"
                            Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="接続テスト" Style="{StaticResource GhostButton}"
                    Click="OnConnectionTest"
                    HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
