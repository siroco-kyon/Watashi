<Window x:Class="Watashi.Client.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続テスト"
        Width="600" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="接続テストと暗号化診断">
    <Border Margin="20" Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="接続テスト" Style="{StaticResource H2}" Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="接続先サーバと機能設定は配布時に管理者が固定しています。ここでは現在の接続先への疎通確認のみ行えます。"/>

            <TextBlock Text="接続先サーバ" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <TextBlock Text="{Binding ServerUrl}" TextWrapping="Wrap" FontFamily="Consolas"/>
            </Border>

            <Border Style="{StaticResource AccessibleWarningBanner}"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="0,0,0,12"
                    ToolTip="接続先 URL から判定した通信暗号化の診断結果です。">
                <TextBlock Text="{Binding TransportSecurityDiagnostic}"
                           Style="{StaticResource AccessibleWarningText}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="接続の暗号化診断"/>
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12">
                <Run Text="ドラッグ＆ドロップ転送: "/><Run Text="{Binding DragDropStatus, Mode=OneWay}" FontWeight="SemiBold"/>
            </TextBlock>

            <TextBlock x:Name="ConnectionStatusLiveRegion"
                       Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                       AutomationProperties.Name="{Binding StatusMessage, StringFormat=接続テスト結果: {0}}"
                       AutomationProperties.LiveSetting="Polite"
                       TextWrapping="Wrap" MinHeight="40"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="接続テスト" Command="{Binding TestConnectionCommand}" MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="閉じる" Style="{StaticResource PrimaryButton}"
                        Click="OnCloseClick" MinWidth="100"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
