<Window x:Class="Watashi.Client.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続設定"
        Width="520" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">
    <Border Margin="20" Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="接続設定" Style="{StaticResource H2}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Text="サーバーURL" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Grid.Row="3" Text="プロトコル" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton GroupName="proto" Content="HTTPS"
                             IsChecked="{Binding Protocol, Converter={StaticResource ProtocolToBool}, ConverterParameter=HTTPS}"
                             Margin="0,0,16,0"/>
                <RadioButton GroupName="proto" Content="HTTP"
                             IsChecked="{Binding Protocol, Converter={StaticResource ProtocolToBool}, ConverterParameter=HTTP}"/>
                <TextBlock Text="⚠ HTTPは平文通信です" Margin="14,0,0,0"
                           Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="接続テスト" Command="{Binding TestConnectionCommand}" MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="保存して閉じる" Style="{StaticResource PrimaryButton}"
                        Click="OnSaveAndCloseClick" MinWidth="130"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
