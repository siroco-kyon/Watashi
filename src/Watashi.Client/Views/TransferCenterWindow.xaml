<Window x:Class="Watashi.Client.Views.TransferCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="転送ジョブセンター" Width="1050" Height="760" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="転送ジョブセンター">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="転送ジョブセンター" Style="{StaticResource H2}"/>
            <TextBlock Text="この画面を開いたまま転送を追加できます。閉じても転送は続きます。" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TransferSummaryLiveRegion" Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="メンテナンス終了とアプリ更新の確認後、メンテナンスで保留した転送を再開します。"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsMaintenanceBlocked, Converter={StaticResource BoolToVis}}"/>
            <Border Style="{StaticResource AccessibleErrorBanner}" Padding="10" Margin="0,8,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock x:Name="TransferErrorLiveRegion" Text="{Binding ErrorMessage}"
                           Style="{StaticResource AccessibleErrorText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label Content="表示(_V):" Target="{Binding ElementName=FilterBox}" VerticalAlignment="Center"/>
                <ComboBox x:Name="FilterBox" Width="170" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                          AutomationProperties.Name="転送状態で絞り込み"/>
            </StackPanel>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="失敗だけ再試行" Command="{Binding RetryFailedCommand}" Margin="0,0,8,4"/>
            <Button Content="すべて中止" Command="{Binding CancelAllCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4"/>
            <Button Content="終了した履歴を消去" Command="{Binding RemoveFinishedCommand}" Margin="0,0,0,4"
                    ToolTip="完了・失敗・中止・スキップ済みの履歴と部分ファイルを消去します"/>
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="選択した転送の詳細" Style="{StaticResource H3}"/>
                <TextBlock Text="一覧から項目を選ぶと、転送元・先と実行できる操作を表示します。" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,8,0,0" DataContext="{Binding SelectedJob}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="転送元" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="転送元パス"/>
                        <TextBlock Text="{Binding SourceMetadata}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="転送先" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DestinationText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="転送先パス"/>
                        <TextBlock Text="{Binding DestinationMetadata}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SelectedJob.ErrorText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="64"/>
                <TextBlock Text="{Binding SelectedJob.RetryAtText}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="再試行" Command="{Binding RetrySelectedCommand}" Margin="0,0,8,4"/>
                    <Button Content="再開" Command="{Binding ResumeSelectedCommand}" Margin="0,0,8,4"/>
                    <Button Content="選択を中止" Command="{Binding CancelSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4"/>
                </WrapPanel>
                <StackPanel Visibility="{Binding SelectedJob.IsConflict, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="同名ファイルがあります。上のサイズ・更新日時を比較し、処理を選んでください。" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <WrapPanel>
                        <Button Content="上書きして再試行" Command="{Binding RetryOverwriteCommand}" Margin="0,0,8,4"/>
                        <Button Content="スキップ" Command="{Binding RetrySkipCommand}" Margin="0,0,8,4"/>
                        <Button Content="別名で再試行" Command="{Binding RetryRenameCommand}" Margin="0,0,8,4"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding VisibleJobs}" SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="転送ジョブ一覧">
            <DataGrid.Columns>
                <DataGridTextColumn Header="方向" Binding="{Binding DirectionLabel}" Width="105"/>
                <DataGridTextColumn Header="ファイル" Binding="{Binding FileName}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="状態" Binding="{Binding StateLabel}" Width="145"/>
                <DataGridTemplateColumn Header="進捗" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="7"
                                             AutomationProperties.Name="{Binding ProgressText}"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
