<Window x:Class="Watashi.Client.Views.PersonalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="個人設定"
        Width="720" Height="720" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="個人設定">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="個人設定" Style="{StaticResource H1}"/>
            <TextBlock Text="このWindowsユーザーで使用する表示・起動・ファイル操作の設定です。"
                       Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}">
            <StackPanel Margin="0,0,6,0">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="起動" Style="{StaticResource H2}" Margin="0,0,0,12"/>

                        <TextBlock Text="ローカルペインの開始位置" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <RadioButton Content="前回開いていたフォルダ"
                                     GroupName="LocalStartup"
                                     IsChecked="{Binding IsLocalLastUsed, Mode=TwoWay}"
                                     AutomationProperties.Name="ローカルは前回開いていたフォルダから開始"/>
                        <RadioButton Content="指定したフォルダ"
                                     GroupName="LocalStartup" Margin="0,5,0,6"
                                     IsChecked="{Binding IsLocalFixed, Mode=TwoWay}"
                                     AutomationProperties.Name="ローカルは指定したフォルダから開始"/>
                        <Grid IsEnabled="{Binding CanChooseFixedLocalPath}" Margin="22,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FixedLocalPathBox" Grid.Column="0"
                                     Text="{Binding FixedLocalPath, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="固定ローカルフォルダ"/>
                            <Button Grid.Column="1" Content="現在地" Margin="6,0,0,0"
                                    Click="OnUseCurrentLocalPath"
                                    AutomationProperties.Name="現在のローカルフォルダを使用"/>
                            <Button Grid.Column="2" Content="参照..." Margin="6,0,0,0"
                                    Click="OnBrowseLocalPath"
                                    AutomationProperties.Name="固定ローカルフォルダを参照"/>
                        </Grid>

                        <Separator Margin="0,2,0,12"/>
                        <TextBlock Text="リモートペインの開始位置" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <RadioButton Content="起動時には選択しない"
                                     GroupName="RemoteStartup"
                                     IsChecked="{Binding IsRemoteNone, Mode=TwoWay}"
                                     AutomationProperties.Name="リモートは起動時に選択しない"/>
                        <RadioButton Content="前回開いていた場所"
                                     GroupName="RemoteStartup" Margin="0,5,0,0"
                                     IsChecked="{Binding IsRemoteLastUsed, Mode=TwoWay}"
                                     IsEnabled="{Binding CanUseRemoteLastPlace}"
                                     AutomationProperties.Name="リモートは前回開いていた場所から開始"/>
                        <RadioButton Content="指定したお気に入り"
                                     GroupName="RemoteStartup" Margin="0,5,0,6"
                                     IsChecked="{Binding IsRemoteFavorite, Mode=TwoWay}"
                                     IsEnabled="{Binding HasRemoteFavorites}"
                                     AutomationProperties.Name="リモートは指定したお気に入りから開始"/>
                        <ComboBox Margin="22,0,0,0"
                                  ItemsSource="{Binding FavoritePlaces}"
                                  SelectedItem="{Binding SelectedRemoteFavorite}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding CanChooseRemoteFavorite}"
                                  AutomationProperties.Name="起動時に開くリモートのお気に入り"/>
                        <TextBlock Text="お気に入りがない場合は、メイン画面で現在地をお気に入りに追加してください。"
                                   Style="{StaticResource Caption}" Margin="22,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="表示" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <TextBlock Text="テーマ" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="ライト" GroupName="Theme"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                         AutomationProperties.Name="ライトテーマ"/>
                            <RadioButton Content="ダーク" GroupName="Theme" Margin="20,0,0,0"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                         AutomationProperties.Name="ダークテーマ"/>
                        </StackPanel>
                        <CheckBox Content="一覧の並び順を次回も使用する"
                                  IsChecked="{Binding RememberSortOrder, Mode=TwoWay}"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="一覧の並び順を記憶"/>
                        <CheckBox Content="ファイルやフォルダーを種類別に色分けする"
                                  IsChecked="{Binding EnableFileTypeColors, Mode=TwoWay}"
                                  Margin="0,8,0,0"
                                  AutomationProperties.Name="ファイルやフォルダーを種類別に色分け"/>
                        <TextBlock Text="フォルダー、CSV、テキスト、文書、画像、圧縮ファイルの名前を色分けします。"
                                   Style="{StaticResource Caption}" Margin="22,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ファイル操作" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <CheckBox Content="ローカル削除時にWindowsのごみ箱を使う"
                                  IsChecked="{Binding UseRecycleBinForLocalDeletes, Mode=TwoWay}"
                                  AutomationProperties.Name="ローカル削除時にWindowsのごみ箱を使用"/>
                        <TextBlock Text="オフにするとローカルファイルは復元できない方法で完全に削除されます。"
                                   Style="{StaticResource Caption}" Margin="22,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="履歴と初期化" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="最近使ったリモート場所を消去"
                                    Click="OnClearRemoteHistory"
                                    Margin="0,0,8,8"
                                    AutomationProperties.Name="最近使ったリモート場所を消去"/>
                            <Button Content="個人設定を初期値に戻す"
                                    Click="OnResetSettings"
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="個人設定を初期値に戻す"/>
                        </WrapPanel>
                        <TextBlock Text="初期化しても、リモートのお気に入りと利用履歴は削除しません。"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PersonalSettingsStatusLiveRegion"
                       Text="{Binding StatusMessage}"
                       Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="個人設定の状態"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="キャンセル" Click="OnCancel" MinWidth="100" Margin="0,0,8,0"/>
                <Button Content="保存" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="100"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}"
                        AutomationProperties.Name="個人設定を保存"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
