<Window x:Class="Watashi.Client.Views.OmikujiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watashiのおみくじ" Width="360" Height="400" MinWidth="280" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="{StaticResource ToriiIcon}"
        AutomationProperties.Name="Watashiのおみくじ" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="20">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="もう一度引く(_D)" Click="OnDraw" Margin="0,0,8,8"/>
            <Button Content="閉じる(_C)" Click="OnClose" Margin="0,0,0,8"/>
        </WrapPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Image Source="{StaticResource ToriiIcon}" Width="64" Height="64" Margin="0,8,0,12"/>
                <TextBlock Text="Watashiのおみくじ" Style="{StaticResource H3}" TextAlignment="Center" TextWrapping="Wrap"/>
                <Border Style="{StaticResource AccessibleSubtleBorder}" Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock x:Name="FortuneText" Style="{StaticResource H2}" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
