<UserControl x:Class="Watashi.Client.Views.Admin.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="メンテナンスの案内と受付" Style="{StaticResource H3}"/>
                    <TextBlock Text="{Binding MaintenanceStateLabel}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding MaintenanceActivityLabel}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding MaintenancePublicationLabel}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <TextBlock Text="利用者への案内"/>
                    <TextBox Text="{Binding MaintenanceMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="60" MaxLength="500" Margin="0,4,0,8"
                             AutomationProperties.Name="メンテナンスの案内文"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="開始予定（このPCの時刻）"/>
                            <TextBox Text="{Binding MaintenanceStartText, UpdateSourceTrigger=PropertyChanged}" Width="190"
                                     ToolTip="yyyy/MM/dd HH:mm。時刻による自動開始は行いません。"
                                     AutomationProperties.Name="メンテナンス開始予定"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="終了予定（このPCの時刻）"/>
                            <TextBox Text="{Binding MaintenanceEndText, UpdateSourceTrigger=PropertyChanged}" Width="190"
                                     ToolTip="yyyy/MM/dd HH:mm。予定時刻を過ぎても自動解除しません。"
                                     AutomationProperties.Name="メンテナンス終了予定"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="予告 → メンテナンス開始 → 処理中0件を確認 → 更新作業 → 復旧確認 → 解除の順で操作します。"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel IsEnabled="{Binding IsSavingMaintenance, Converter={StaticResource NotBool}}">
                        <Button Content="状態を再取得" Command="{Binding RefreshMaintenanceCommand}" Margin="0,0,6,6"/>
                        <Button Content="予告を公開" Command="{Binding ChangeMaintenanceCommand}" CommandParameter="scheduled" Margin="0,0,6,6"/>
                        <Button Content="メンテナンス開始" Command="{Binding ChangeMaintenanceCommand}" CommandParameter="maintenance" Margin="0,0,6,6"/>
                        <Button Content="復旧確認へ" Command="{Binding ChangeMaintenanceCommand}" CommandParameter="recovering" Margin="0,0,6,6"/>
                        <Button Content="解除して通常へ" Command="{Binding ChangeMaintenanceCommand}" CommandParameter="normal" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="↻ 再診断" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="運用状態を再診断"/>
                    <StackPanel>
                        <TextBlock Text="運用状態" Style="{StaticResource H3}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="総合: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OverallStatusLabel}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CheckedAt, Converter={StaticResource Utc}, StringFormat=　確認: {0}}"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="OperationsStatusLiveRegion" Text="{Binding StatusMessage}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="2" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,6">
                    <StackPanel>
                        <TextBlock Text="データベース" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Database.Status, Converter={StaticResource DiagnosticStatusLabel}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Database.Message}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="6,0,0,6">
                    <StackPanel>
                        <TextBlock Text="監査ログ再送" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AuditOutbox.Status, Converter={StaticResource DiagnosticStatusLabel}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding AuditOutbox.Message}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,6,6,0">
                    <StackPanel>
                        <TextBlock Text="ディスク" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Disk.Status, Converter={StaticResource DiagnosticStatusLabel}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Disk.Message}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="6,6,0,0">
                    <StackPanel>
                        <TextBlock Text="バックアップ" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Backup.Status, Converter={StaticResource DiagnosticStatusLabel}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Backup.Message}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,6,6,0">
                    <StackPanel>
                        <TextBlock Text="HTTPS証明書" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Certificate.Status, Converter={StaticResource DiagnosticStatusLabel}}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Certificate.Message}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                        <TextBlock Text="実行ノード" Style="{StaticResource H3}"/>
                    </Border>
                    <ListView ItemsSource="{Binding Nodes}" BorderThickness="0,1,0,0"
                              ItemContainerStyle="{StaticResource GridViewListViewItemStyle}"
                              AutomationProperties.Name="実行ノード診断一覧">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                <GridViewColumn Header="種類" DisplayMemberBinding="{Binding NodeType}" Width="80"/>
                                <GridViewColumn Header="状態" DisplayMemberBinding="{Binding Status, Converter={StaticResource DiagnosticStatusLabel}}" Width="90"/>
                                <GridViewColumn Header="経路" DisplayMemberBinding="{Binding EndpointScheme}" Width="70"/>
                                <GridViewColumn Header="最終Heartbeat" DisplayMemberBinding="{Binding LastHeartbeatAt, Converter={StaticResource Utc}}" Width="165"/>
                                <GridViewColumn Header="上限" DisplayMemberBinding="{Binding MaxConcurrency}" Width="60"/>
                                <GridViewColumn Header="詳細" DisplayMemberBinding="{Binding Message}" Width="280"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
