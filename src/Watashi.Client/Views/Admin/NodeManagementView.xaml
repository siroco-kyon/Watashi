<UserControl x:Class="Watashi.Client.Views.Admin.NodeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="実行ノード" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button Content="🗑 削除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                    <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label" ToolTip="並び替え" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ノードを検索"/>
                </DockPanel>
                <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" BorderThickness="0,1,0,0"
                          ItemContainerStyle="{StaticResource GridViewListViewItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                            <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="160"/>
                            <GridViewColumn Header="種別" DisplayMemberBinding="{Binding NodeType}" Width="80"/>
                            <GridViewColumn Header="Endpoint" DisplayMemberBinding="{Binding Endpoint}" Width="240"/>
                            <GridViewColumn Header="経由" DisplayMemberBinding="{Binding GatewayNodeName}" Width="140"/>
                            <GridViewColumn Header="Health" DisplayMemberBinding="{Binding HealthStatus}" Width="90"/>
                            <GridViewColumn Header="LastBeat" DisplayMemberBinding="{Binding LastHeartbeatAt, Converter={StaticResource Utc}}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <TextBlock Text="ノード設定" Style="{StaticResource H3}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="新規ノード" Style="{StaticResource H3}" Margin="0,0,0,10"/>

                        <TextBlock Text="名称" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="種別" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding NewType}" Margin="0,0,0,10">
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Direct</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Agent</sys:String>
                        </ComboBox>

                        <TextBlock Text="Endpoint (例: http://agent:8081)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <CheckBox Content="別の Agent を経由する (1段チェーン)" IsChecked="{Binding NewUseGateway}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Items}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding NewGatewayNodeId}"
                                  IsEnabled="{Binding NewUseGateway}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="MaxConcurrency" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewMaxConcurrency}" Margin="0,0,0,14"/>

                        <Button Content="＋ 作成" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Height="34"/>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,18,0,16"/>

                        <TextBlock Text="選択ノードを更新" Style="{StaticResource H3}" Margin="0,0,0,10"/>

                        <TextBlock Text="名称" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Endpoint" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <CheckBox Content="有効" IsChecked="{Binding EditIsActive}" Margin="0,0,0,8"/>
                        <CheckBox Content="別の Agent を経由する (1段チェーン)" IsChecked="{Binding EditUseGateway}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Items}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding EditGatewayNodeId}"
                                  IsEnabled="{Binding EditUseGateway}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="MaxConcurrency" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditMaxConcurrency}" Margin="0,0,0,14"/>

                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" Height="34"/>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
