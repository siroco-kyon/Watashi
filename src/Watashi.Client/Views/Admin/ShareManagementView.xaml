<UserControl x:Class="Watashi.Client.Views.Admin.ShareManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
            <Button Content="削除" Command="{Binding DeleteCommand}"/>
        </ToolBar>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ComboBox Width="160" ItemsSource="{Binding Hosts}" SelectedItem="{Binding NewHost}" DisplayMemberPath="Name" Margin="4,0"/>
            <TextBox Width="160" Text="{Binding NewShareName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="共有名(SMB)"/>
            <TextBox Width="160" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="表示名"/>
            <Button Content="作成" Command="{Binding CreateCommand}" Margin="4,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="ホスト" DisplayMemberBinding="{Binding HostName}" Width="160"/>
                    <GridViewColumn Header="共有名" DisplayMemberBinding="{Binding ShareName}" Width="160"/>
                    <GridViewColumn Header="表示名" DisplayMemberBinding="{Binding DisplayName}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
