<UserControl x:Class="Watashi.Client.Views.Admin.ShareManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="共有 (Share)" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button Content="🗑 削除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                    <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label" ToolTip="並び替え" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="共有を検索"/>
                </DockPanel>
                <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" BorderThickness="0,1,0,0"
                          ItemContainerStyle="{StaticResource GridViewListViewItemStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                            <GridViewColumn Header="ホスト" DisplayMemberBinding="{Binding HostName}" Width="160"/>
                            <GridViewColumn Header="共有名" DisplayMemberBinding="{Binding ShareName}" Width="160"/>
                            <GridViewColumn Header="表示名" DisplayMemberBinding="{Binding DisplayName}" Width="200"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <!-- Edit / Create form -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <TextBlock Text="共有情報" Style="{StaticResource H3}"/>
                </Border>
                <StackPanel Margin="16">
                    <TextBlock Text="選択中の共有" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Selected.DisplayName, TargetNullValue=共有を選択してください}"
                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="対象ホスト" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Hosts}" SelectedValue="{Binding EditHostId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" IsEnabled="{Binding HasSelected}" Margin="0,0,0,10"/>

                    <TextBlock Text="共有名 (SMBの共有名)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditShareName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelected}" Margin="0,0,0,10"/>

                    <TextBlock Text="表示名" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasSelected}" Margin="0,0,0,14"/>

                    <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding HasSelected}" Height="34"/>

                    <Separator Margin="0,16,0,14"/>

                    <TextBlock Text="共有を追加" Style="{StaticResource H3}" Margin="0,0,0,12"/>

                    <TextBlock Text="対象ホスト" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Hosts}" SelectedValue="{Binding NewHostId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,0,0,10"/>

                    <TextBlock Text="共有名 (SMBの共有名)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewShareName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="表示名" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Button Content="＋ 作成" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Height="34"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
