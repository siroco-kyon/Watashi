<UserControl x:Class="Watashi.Client.Views.Admin.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
        </ToolBar>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="値:" VerticalAlignment="Center"/>
            <TextBox Width="300" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Margin="4,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="DarkGreen" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="220"/>
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="220"/>
                    <GridViewColumn Header="更新" DisplayMemberBinding="{Binding UpdatedAt, Converter={StaticResource Utc}}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
