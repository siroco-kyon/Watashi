<UserControl x:Class="Watashi.Client.Views.Admin.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="システム設定" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                    <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label" ToolTip="並び替え" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="設定を検索"/>
                </DockPanel>
                <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" BorderThickness="0,1,0,0"
                          ItemContainerStyle="{StaticResource GridViewListViewItemStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Key" DisplayMemberBinding="{Binding Key}" Width="240"/>
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="260"/>
                            <GridViewColumn Header="更新" DisplayMemberBinding="{Binding UpdatedAt, Converter={StaticResource Utc}}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <TextBlock Text="値を編集" Style="{StaticResource H3}"/>
                </Border>
                <StackPanel Margin="16">
                    <TextBlock Text="選択した Key の値" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                    <Button Content="💾 保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Height="34"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
