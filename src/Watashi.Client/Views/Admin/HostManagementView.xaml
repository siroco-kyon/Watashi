<UserControl x:Class="Watashi.Client.Views.Admin.HostManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
            <Button Content="削除" Command="{Binding DeleteCommand}"/>
            <Button Content="接続テスト" Command="{Binding TestCommand}"/>
        </ToolBar>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="新規:" VerticalAlignment="Center"/>
            <TextBox Width="120" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="表示名"/>
            <TextBox Width="160" Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="ホスト名/IP"/>
            <TextBox Width="60" Text="{Binding Port}" Margin="4,0" ToolTip="ポート"/>
            <TextBox Width="120" Text="{Binding CredUser, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="CIFSユーザー"/>
            <TextBox Width="120" Text="{Binding CredPassword, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" ToolTip="CIFSパスワード"/>
            <ComboBox Width="120" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" DisplayMemberPath="Name" Margin="4,0"/>
            <Button Content="作成" Command="{Binding CreateCommand}" Margin="4,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="160"/>
                    <GridViewColumn Header="アドレス" DisplayMemberBinding="{Binding HostAddress}" Width="160"/>
                    <GridViewColumn Header="Port" DisplayMemberBinding="{Binding Port}" Width="60"/>
                    <GridViewColumn Header="ユーザー" DisplayMemberBinding="{Binding CredUsername}" Width="120"/>
                    <GridViewColumn Header="ノード" DisplayMemberBinding="{Binding ExecutionNodeName}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
