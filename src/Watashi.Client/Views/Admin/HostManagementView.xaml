<UserControl x:Class="Watashi.Client.Views.Admin.HostManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Watashi.Client.Controls">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- List -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="ホスト" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button Content="🔌 接続テスト" Command="{Binding TestCommand}" Margin="0,0,6,0"/>
                            <Button Content="🗑 削除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                    <ComboBox DockPanel.Dock="Right" Width="120" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label" ToolTip="並び替え" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="ホストを検索"/>
                </DockPanel>
                <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" BorderThickness="0,1,0,0"
                          ItemContainerStyle="{StaticResource GridViewListViewItemStyle}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                            <GridViewColumn Header="名前" DisplayMemberBinding="{Binding Name}" Width="160"/>
                            <GridViewColumn Header="アドレス" DisplayMemberBinding="{Binding HostAddress}" Width="160"/>
                            <GridViewColumn Header="Port" DisplayMemberBinding="{Binding Port}" Width="60"/>
                            <GridViewColumn Header="ユーザー" DisplayMemberBinding="{Binding CredUsername}" Width="120"/>
                            <GridViewColumn Header="ノード" DisplayMemberBinding="{Binding ExecutionNodeName}" Width="160"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <!-- Form -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <TextBlock Text="ホスト情報" Style="{StaticResource H3}"/>
                </Border>
                <StackPanel Margin="16">
                    <TextBlock Text="表示名" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="ホスト名 / IP" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ポート" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="実行ノード" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Port}"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Nodes}" SelectedValue="{Binding SelectedNodeId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name"/>
                    </Grid>

                    <TextBlock Text="CIFSユーザー" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CredUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <TextBlock Text="CIFSパスワード" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <ctl:PasswordRevealBox Password="{Binding CredPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="編集時に空欄のままにすると、保存されているパスワードを保持します。"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋ 新規作成" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Margin="0,0,6,0"/>
                        <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                        <Button Content="クリア" Style="{StaticResource GhostButton}" Command="{Binding ClearFormCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
