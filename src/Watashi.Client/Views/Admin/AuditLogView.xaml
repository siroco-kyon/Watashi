<UserControl x:Class="Watashi.Client.Views.Admin.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="14" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                <DockPanel>
                    <TextBlock Text="操作ログ" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PageSummary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Button Content="↻ 更新" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                        <Button Content="🔍 検索" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,6,0"/>
                        <Button Content="📤 CSV出力" Command="{Binding ExportCsvCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="名前 / ユーザー名 / ID" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="130" Text="{Binding FilterUser, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="操作カテゴリ" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <ComboBox Width="125" ItemsSource="{Binding CategoryOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding FilterCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="操作" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <ComboBox Width="200" ItemsSource="{Binding OperationOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding FilterOp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="結果" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <ComboBox Width="95" ItemsSource="{Binding ResultOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding FilterResult, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="開始日 (ローカル)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <DatePicker Width="125" SelectedDate="{Binding FilterFrom}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,6">
                            <TextBlock Text="終了日 (ローカル)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <DatePicker Width="125" SelectedDate="{Binding FilterTo}"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,2">
                            <TextBlock Text="ホスト / ID" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="130" Text="{Binding FilterHost, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,2">
                            <TextBlock Text="共有 / ID" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="130" Text="{Binding FilterShare, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,2">
                            <TextBlock Text="パス / 移動先" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="210" Text="{Binding FilterPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,2">
                            <TextBlock Text="ノード / ID" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="130" Text="{Binding FilterNode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,2">
                            <TextBlock Text="端末名 / IP" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                            <TextBox Width="150" Text="{Binding FilterDevice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="条件をクリア" Command="{Binding ClearFiltersCommand}"
                                VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                       Margin="16,6,16,0" DockPanel.Dock="Top" TextWrapping="Wrap"/>

            <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                <DockPanel>
                    <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="≪ 最初" Command="{Binding FirstPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" Margin="0,0,5,0"/>
                        <Button Content="‹ 前へ" Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding PageNumberSummary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="次へ ›" Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" Margin="0,0,5,0"/>
                        <Button Content="最後 ≫" Command="{Binding LastPageCommand}"
                                IsEnabled="{Binding CanGoNext}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ListView ItemsSource="{Binding Items}" BorderThickness="0,1,0,0"
                      ItemContainerStyle="{StaticResource GridViewListViewItemStyle}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                        <GridViewColumn Header="時刻" DisplayMemberBinding="{Binding Timestamp, Converter={StaticResource Utc}}" Width="160"/>
                        <GridViewColumn Header="User" DisplayMemberBinding="{Binding UserDisplayLabel}" Width="200"/>
                        <GridViewColumn Header="端末 / IP" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClientHostname}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ClientIp}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="カテゴリ" DisplayMemberBinding="{Binding OperationCategoryLabel}" Width="90"/>
                        <GridViewColumn Header="操作" DisplayMemberBinding="{Binding OperationLabel}" Width="145"/>
                        <GridViewColumn Header="結果" DisplayMemberBinding="{Binding Result}" Width="70"/>
                        <GridViewColumn Header="ホスト / 共有" Width="205">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding DisplayLocation}">
                                        <TextBlock Text="{Binding HostDisplay}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ShareDisplay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Path" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding DisplayLocation}">
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TargetPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ノード" DisplayMemberBinding="{Binding NodeDisplay}" Width="120"/>
                        <GridViewColumn Header="Bytes" DisplayMemberBinding="{Binding BytesTransferred, Converter={StaticResource SizeFmt}}" Width="90"/>
                        <GridViewColumn Header="Dur(ms)" DisplayMemberBinding="{Binding DurationMs}" Width="70"/>
                        <GridViewColumn Header="Err" DisplayMemberBinding="{Binding ErrorMessage}" Width="240"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
