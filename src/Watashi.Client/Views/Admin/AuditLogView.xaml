<UserControl x:Class="Watashi.Client.Views.Admin.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="14" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                <DockPanel>
                    <TextBlock Text="操作ログ" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TotalCount, StringFormat=Total: {0}}" Margin="0,0,12,0"/>
                        <Button Content="🔍 検索" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                        <Button Content="📤 CSV出力" Command="{Binding ExportCsvCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <WrapPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="User" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBox Width="140" Text="{Binding FilterUser, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="Operation" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBox Width="130" Text="{Binding FilterOp, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="From (UTC)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding FilterFrom}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,4">
                        <TextBlock Text="To (UTC)" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding FilterTo}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                       Margin="16,6,16,0" DockPanel.Dock="Top" TextWrapping="Wrap"/>

            <!--
                旧 UI は HostId / ShareId の数値だけが出ていたため、"どこのどの共有のどのパスか" が
                ログだけ眺めても分からなかった。サーバ側で left-join した HostName / ShareName を
                受け取り、(ホスト名 / 共有名) を 2 行レイアウトで表示。ホバー時はパス + 完全な location を
                ツールチップで全文確認できる。削除済みのホスト/共有は「(削除済)」とマークする。
            -->
            <ListView ItemsSource="{Binding Items}" BorderThickness="0,1,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                        <GridViewColumn Header="時刻" DisplayMemberBinding="{Binding Timestamp, Converter={StaticResource Utc}}" Width="160"/>
                        <GridViewColumn Header="User" DisplayMemberBinding="{Binding Username}" Width="120"/>
                        <GridViewColumn Header="端末" DisplayMemberBinding="{Binding ClientHostname}" Width="120"/>
                        <GridViewColumn Header="Op" DisplayMemberBinding="{Binding OperationLabel}" Width="110"/>
                        <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="70"/>
                        <GridViewColumn Header="ホスト / 共有" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel ToolTip="{Binding DisplayLocation}">
                                        <TextBlock Text="{Binding HostDisplay}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ShareDisplay}"
                                                   Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Path" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayLocation}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Bytes" DisplayMemberBinding="{Binding BytesTransferred, Converter={StaticResource SizeFmt}}" Width="90"/>
                        <GridViewColumn Header="Dur(ms)" DisplayMemberBinding="{Binding DurationMs}" Width="70"/>
                        <GridViewColumn Header="Err" DisplayMemberBinding="{Binding ErrorMessage}" Width="240"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
