<UserControl x:Class="Watashi.Client.Views.Admin.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
            <TextBlock Text="ユーザー:" VerticalAlignment="Center" Margin="20,0,4,0"/>
            <ComboBox Width="180" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username"/>
            <Button Content="全デバイス失効" Command="{Binding RevokeAllCommand}" Margin="8,0,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </ToolBar>
        <ListView ItemsSource="{Binding Devices}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="マシン" DisplayMemberBinding="{Binding MachineName}" Width="160"/>
                    <GridViewColumn Header="Windowsユーザー" DisplayMemberBinding="{Binding WindowsUsername}" Width="160"/>
                    <GridViewColumn Header="登録" DisplayMemberBinding="{Binding RegisteredAt, Converter={StaticResource Utc}}" Width="160"/>
                    <GridViewColumn Header="最終使用" DisplayMemberBinding="{Binding LastUsedAt, Converter={StaticResource Utc}}" Width="160"/>
                    <GridViewColumn Header="失効" DisplayMemberBinding="{Binding IsRevoked}" Width="60"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
