<UserControl x:Class="Watashi.Client.Views.Admin.DeviceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="14" Style="{StaticResource Card}" Padding="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                <DockPanel>
                    <TextBlock Text="信頼デバイス" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                        <Button Content="選択ユーザーを失効" Command="{Binding RevokeAllCommand}" Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding HasSelectedDevice}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                          DisplayMemberPath="Label" ToolTip="並び替え" Margin="6,0,0,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="名前、ユーザー名、端末、Windowsユーザーを検索"/>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                       Margin="16,8,16,0" DockPanel.Dock="Top" TextWrapping="Wrap"/>
            <ListView ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0,1,0,0"
                      ItemContainerStyle="{StaticResource GridViewListViewItemStyle}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="ユーザー" DisplayMemberBinding="{Binding DisplayLabel}" Width="220"/>
                        <GridViewColumn Header="マシン" DisplayMemberBinding="{Binding MachineName}" Width="200"/>
                        <GridViewColumn Header="Windowsユーザー" DisplayMemberBinding="{Binding WindowsUsername}" Width="200"/>
                        <GridViewColumn Header="登録" DisplayMemberBinding="{Binding RegisteredAt, Converter={StaticResource Utc}}" Width="160"/>
                        <GridViewColumn Header="最終使用" DisplayMemberBinding="{Binding LastUsedAt, Converter={StaticResource Utc}}" Width="160"/>
                        <GridViewColumn Header="失効" DisplayMemberBinding="{Binding IsRevoked}" Width="64"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
