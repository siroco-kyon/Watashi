<UserControl x:Class="Watashi.Client.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Watashi.Client.Controls">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Users list -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="ユーザー一覧" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button Content="📥 CSV取込" Command="{Binding ImportCsvCommand}" ToolTip="CSV ファイルからユーザーを一括登録" Margin="0,0,6,0"/>
                            <Button Content="📤 CSV出力" Command="{Binding ExportCsvCommand}" ToolTip="ユーザー一覧を CSV として保存" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                            <Button Content="🔓 ロック解除" Command="{Binding UnlockCommand}" Margin="0,0,6,0"/>
                            <Button Content="🔑 初期PW発行" Click="OnResetPw" Margin="0,0,6,0"
                                    ToolTip="Windows 認証が使えない端末向け。管理者が初期パスワードを決めて本人に伝えます。"/>
                            <Button Content="↩ 初回設定に戻す" Command="{Binding RequireSetupCommand}" Margin="0,0,6,0"
                                    ToolTip="パスワードを破棄し、本人に再度設定させます。セッションと記憶済み端末も失効します。"/>
                            <Button Content="🗑 削除" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="10,8,10,8">
                    <ComboBox DockPanel.Dock="Right"
                              Width="130"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label"
                              ToolTip="並び替え"
                              Margin="6,0,0,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="ユーザー一覧を検索"/>
                </DockPanel>
                <Grid>
                    <ListView x:Name="UserList"
                              ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding Selected}"
                              BorderThickness="0,1,0,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                                <GridViewColumn Header="ユーザー名" DisplayMemberBinding="{Binding Username}" Width="180"/>
                                <GridViewColumn Header="管理者" DisplayMemberBinding="{Binding IsAdmin}" Width="64"/>
                                <GridViewColumn Header="Lock" DisplayMemberBinding="{Binding IsLocked}" Width="60"/>
                                <GridViewColumn Header="PW状態" DisplayMemberBinding="{Binding PasswordStatusLabel}" Width="100"/>
                                <GridViewColumn Header="PW期限" DisplayMemberBinding="{Binding PasswordExpiresAt, Converter={StaticResource Utc}}" Width="160"/>
                                <GridViewColumn Header="最終ログイン" DisplayMemberBinding="{Binding LastLoginAt, Converter={StaticResource Utc}}" Width="160"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="20" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=UserList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="ユーザーがいません" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="右側のフォームからユーザーを作成してください"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <!-- Edit / Create form -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <TextBlock Text="ユーザー情報" Style="{StaticResource H3}"/>
                </Border>
                <StackPanel Margin="16">
                    <TextBlock Text="選択中のユーザー" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Selected.Username, TargetNullValue=ユーザーを選択してください}"
                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <CheckBox Content="管理者"
                              IsChecked="{Binding EditIsAdmin}"
                              IsEnabled="{Binding HasSelected}"
                              Margin="0,0,0,12"/>

                    <Button Content="保存"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding HasSelected}"
                            Height="34"
                            Margin="0,0,0,14"/>

                    <Separator Margin="0,0,0,14"/>

                    <TextBlock Text="新規ユーザー" Style="{StaticResource H3}" Margin="0,0,0,12"/>

                    <TextBlock Text="ユーザー名 (GID)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Windows のログオン名と同じ GID にしてください。初回ログイン時の本人確認に使われます。"/>

                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="初期パスワードの設定は不要です。本人が初回ログイン時に自分で決めます。Windows 認証が使えない端末の場合は、作成後に「初期PW発行」を使ってください。"/>

                    <CheckBox Content="管理者として作成" IsChecked="{Binding NewIsAdmin}" Margin="0,0,0,12"/>

                    <Button Content="＋ 作成" Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}" Height="34"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
