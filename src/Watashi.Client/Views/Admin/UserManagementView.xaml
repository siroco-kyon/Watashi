<UserControl x:Class="Watashi.Client.Views.Admin.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
            <Separator/>
            <Button Content="削除" Command="{Binding DeleteCommand}"/>
            <Button Content="ロック解除" Command="{Binding UnlockCommand}"/>
            <Button Content="PWリセット" Click="OnResetPw"/>
        </ToolBar>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="新規: " VerticalAlignment="Center"/>
            <TextBox Width="120" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
            <TextBox Width="160" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
            <CheckBox Content="管理者" IsChecked="{Binding NewIsAdmin}" Margin="4,0" VerticalAlignment="Center"/>
            <Button Content="作成" Command="{Binding CreateCommand}" Margin="4,0"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="ユーザー名" DisplayMemberBinding="{Binding Username}" Width="160"/>
                    <GridViewColumn Header="管理者" DisplayMemberBinding="{Binding IsAdmin}" Width="60"/>
                    <GridViewColumn Header="Lock" DisplayMemberBinding="{Binding IsLocked}" Width="60"/>
                    <GridViewColumn Header="期限" DisplayMemberBinding="{Binding PasswordExpiresAt, Converter={StaticResource Utc}}" Width="160"/>
                    <GridViewColumn Header="最終ログイン" DisplayMemberBinding="{Binding LastLoginAt, Converter={StaticResource Utc}}" Width="160"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
