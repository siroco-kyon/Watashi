<UserControl x:Class="Watashi.Client.Views.Admin.UserPermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <ToolBar DockPanel.Dock="Top">
            <Button Content="再読み込み" Command="{Binding RefreshCommand}"/>
            <Button Content="削除" Command="{Binding DeleteCommand}"/>
            <TextBlock Text="ユーザー:" VerticalAlignment="Center" Margin="20,0,4,0"/>
            <ComboBox Width="160" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username"/>
        </ToolBar>
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="共有:" VerticalAlignment="Center"/>
                <ComboBox Width="180" ItemsSource="{Binding Shares}" SelectedItem="{Binding NewShare}" DisplayMemberPath="DisplayName" Margin="4,0"/>
                <TextBlock Text="テンプレ:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ComboBox Width="160" ItemsSource="{Binding Templates}" SelectedItem="{Binding NewTemplate}" DisplayMemberPath="Name" Margin="4,0"/>
                <TextBlock Text="パス:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Width="180" Text="{Binding NewAllowedPath, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                <TextBlock Text="表示名:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBox Width="160" Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                <Button Content="追加" Command="{Binding CreateCommand}" Margin="4,0"/>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,4,0,4">
                <TextBlock Text="ブラウズ: " VerticalAlignment="Center"/>
                <TextBox Width="240" Text="{Binding BrowsePath, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                <Button Content="開く" Command="{Binding BrowseCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="Red" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding BrowseEntries}" DisplayMemberPath="Name"/>
        </Grid>
        <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="ユーザー" DisplayMemberBinding="{Binding Username}" Width="120"/>
                    <GridViewColumn Header="ホスト" DisplayMemberBinding="{Binding HostName}" Width="120"/>
                    <GridViewColumn Header="共有" DisplayMemberBinding="{Binding ShareName}" Width="120"/>
                    <GridViewColumn Header="パス" DisplayMemberBinding="{Binding AllowedPath}" Width="180"/>
                    <GridViewColumn Header="テンプレ" DisplayMemberBinding="{Binding TemplateName}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
