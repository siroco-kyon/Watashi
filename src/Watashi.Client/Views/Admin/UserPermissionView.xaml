<UserControl x:Class="Watashi.Client.Views.Admin.UserPermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left: User list ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="ユーザー" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding UserSummaries.Count, Mode=OneWay}"
                                       Foreground="{StaticResource AccentDeepBrush}" FontSize="11"/>
                        </Border>
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                    <ComboBox DockPanel.Dock="Right"
                              Width="92"
                              ItemsSource="{Binding UserSortOptions}"
                              SelectedItem="{Binding SelectedUserSortOption}"
                              DisplayMemberPath="Label"
                              ToolTip="ユーザーの並び替え"
                              Margin="6,0,0,0"/>
                    <Grid>
                        <TextBox Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="30,5,8,5"
                                 ToolTip="名前またはユーザー名で絞り込み"/>
                        <TextBlock Text="🔍" FontSize="13" Margin="9,0,0,0"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </DockPanel>

                <Button Content="🔄 再読み込み" Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Margin="10"
                        HorizontalAlignment="Stretch"/>

                <Grid>
                    <ListBox ItemsSource="{Binding UserSummaries}"
                             SelectedItem="{Binding SelectedSummary, Mode=TwoWay}"
                             BorderThickness="0,1,0,0"
                             BorderBrush="{StaticResource BorderBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="ToolTip" Value="{Binding DisplayLabel}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="管理者"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource AccentDeepBrush}" FontSize="11">
                                                <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                <Run Text="件"/>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoUsers, Converter={StaticResource BoolToVis}}"
                                Margin="20" IsHitTestVisible="False">
                        <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="ユーザーがいません" HorizontalAlignment="Center"
                                   Style="{StaticResource Muted}"/>
                        <TextBlock Text="「ユーザー」タブで作成してください" HorizontalAlignment="Center"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="Transparent" Width="12"/>

        <!-- ===== Right: Permissions for selected user ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User header -->
                <Border Grid.Row="0" Style="{StaticResource SectionHeader}" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <TextBlock Text="{Binding SelectedUserHeader}" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"
                                   HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusMessage}"/>
                    </DockPanel>
                </Border>

                <!-- Granted permissions list (takes flex space) -->
                <DockPanel Grid.Row="1" Margin="14,12,14,4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="付与済みのパス" Style="{StaticResource H3}" DockPanel.Dock="Left"/>
                        <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center">
                            <Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=" 件"/>
                        </TextBlock>
                        <Button Style="{StaticResource DangerButton}"
                                Content="🗑 選択を削除"
                                Command="{Binding DeleteCommand}"
                                HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                        <ComboBox Width="120"
                                  ItemsSource="{Binding PermissionSortOptions}"
                                  SelectedItem="{Binding SelectedPermissionSortOption}"
                                  DisplayMemberPath="Label"
                                  ToolTip="付与済みパスの並び替え"
                                  HorizontalAlignment="Right"
                                  DockPanel.Dock="Right"
                                  Margin="0,0,6,0"/>
                        <TextBox Width="170"
                                 Text="{Binding PermissionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="付与済みパスを検索"
                                 HorizontalAlignment="Right"
                                 DockPanel.Dock="Right"
                                 Margin="0,0,6,0"/>
                    </DockPanel>

                    <!-- Quick add: bundle apply + copy from user -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardSubtle}" Margin="0,0,0,8"
                            IsEnabled="{Binding HasSelectedUser}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Bundle apply -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">
                                    <Run Text="📦 セットから一括適用"/>
                                </TextBlock>
                                <DockPanel>
                                    <Button Content="適用" DockPanel.Dock="Right" MinWidth="64" Margin="6,0,0,0"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ApplyBundleCommand}"/>
                                    <ComboBox ItemsSource="{Binding Bundles}"
                                              SelectedItem="{Binding SelectedBundle}"
                                              DisplayMemberPath="Name"
                                              ToolTip="権限セットタブで作成したセットを選択"/>
                                </DockPanel>
                            </StackPanel>
                            <!-- Copy from another user -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">
                                    <Run Text="📋 他ユーザーから全件コピー"/>
                                </TextBlock>
                                <DockPanel>
                                    <Button Content="コピー" DockPanel.Dock="Right" MinWidth="64" Margin="6,0,0,0"
                                            Command="{Binding CopyFromUserCommand}"/>
                                    <ComboBox ItemsSource="{Binding CopyFromCandidates}"
                                              SelectedItem="{Binding CopyFromUser}"
                                              DisplayMemberPath="DisplayLabel"
                                              ToolTip="このユーザーの全権限を上の選択ユーザーへ複製"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="ホスト: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding HostName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="共有: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ShareName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="パス: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding AllowedPath, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="テンプレ: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding TemplateName, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="状態: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding EffectiveStatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="開始: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ValidFrom, Converter={StaticResource Utc}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="期限: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ExpiresAt, Converter={StaticResource Utc}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="理由: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Reason, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="申請番号: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding TicketNumber, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding WarningSummary}" Foreground="{StaticResource WarningBrush}"
                                                           TextWrapping="Wrap" MaxWidth="420"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ホスト" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding HostName}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="共有" Width="140">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ShareName}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="パス" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AllowedPath}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="テンプレ" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TemplateName}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="表示名" Width="160">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="状態" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EffectiveStatusLabel}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EffectiveStatus}" Value="scheduled">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EffectiveStatus}" Value="expired">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="有効期限" DisplayMemberBinding="{Binding ExpiresAt, Converter={StaticResource Utc}}" Width="145"/>
                                    <GridViewColumn Header="理由" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}" ToolTip="{Binding Reason}" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="申請番号" DisplayMemberBinding="{Binding TicketNumber}" Width="105"/>
                                    <GridViewColumn Header="警告" Width="65">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding WarningLabel}" ToolTip="{Binding WarningSummary}"
                                                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}"
                                    Margin="20" IsHitTestVisible="False">
                            <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="このユーザーには付与済みのパスがありません"
                                       Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="下の「＋ パスを追加」から登録できます"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>

                <!-- 追加・編集・実効権限プレビューを同じ判定文脈で扱う。 -->
                <TabControl Grid.Row="2" Margin="14,4,14,14" MaxHeight="410"
                            IsEnabled="{Binding HasSelectedUser}">
                    <TabItem Header="＋ パスを追加">
                        <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="サーバー" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="共有" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Shares}" SelectedItem="{Binding NewShare}" DisplayMemberPath="DisplayName"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="権限テンプレート" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding NewTemplate}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="表示名 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="許可パス" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewAllowedPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding NewAllowedPath}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="6" Grid.Column="0">
                                        <TextBlock Text="有効開始 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewValidFromText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding LocalDateTimeHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="2">
                                        <TextBlock Text="有効期限 (任意・時刻で失効)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewExpiresAtText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding LocalDateTimeHint}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="8" Grid.Column="0">
                                        <TextBlock Text="理由 (任意・500文字以内)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="8" Grid.Column="2">
                                        <TextBlock Text="チケット/申請番号 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewTicketNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="ブラウズ (選択した共有内の実在パスを参照)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button Content="開く" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" MinWidth="68" Margin="6,0,0,0"/>
                                            <TextBox Text="{Binding BrowsePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding BrowsePath}"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <ListBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3"
                                             ItemsSource="{Binding BrowseEntries}" SelectedItem="{Binding SelectedBrowseEntry}"
                                             DisplayMemberPath="Name" Height="64"
                                             ToolTip="サブフォルダをクリックすると許可パスに反映されます"/>
                                    <Button Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="3"
                                            Style="{StaticResource PrimaryButton}" Content="＋ この期限付き権限を追加"
                                            Command="{Binding CreateCommand}" Height="36"/>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="✏ 選択を編集" IsEnabled="{Binding HasSelectedPermission}">
                        <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap">
                                        <Run Text="対象: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding Selected.HostName}"/><Run Text=" / "/>
                                        <Run Text="{Binding Selected.ShareName}"/><Run Text="  Permission #"/>
                                        <Run Text="{Binding Selected.Id}"/>
                                    </TextBlock>
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="権限テンプレート" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding EditTemplate}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="表示名 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="許可パス" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditAllowedPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="0">
                                        <TextBlock Text="有効開始 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditValidFromText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding LocalDateTimeHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="6" Grid.Column="2">
                                        <TextBlock Text="有効期限 (任意・時刻で失効)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditExpiresAtText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding LocalDateTimeHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="8" Grid.Column="0">
                                        <TextBlock Text="理由 (任意・500文字以内)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="8" Grid.Column="2">
                                        <TextBlock Text="チケット/申請番号 (任意)" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding EditTicketNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="{Binding Selected.WarningSummary}" Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="選択した権限を更新"
                                                Command="{Binding UpdateSelectedCommand}" Height="36"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="🔎 実効権限プレビュー">
                        <Border Style="{StaticResource CardSubtle}" Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="サーバー" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" DisplayMemberPath="Name"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="共有" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Shares}" SelectedItem="{Binding SimulationShare}" DisplayMemberPath="DisplayName"/>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,8,0,8">
                                        <Button Content="判定" Command="{Binding SimulateCommand}" DockPanel.Dock="Right"
                                                Style="{StaticResource PrimaryButton}" MinWidth="80" Margin="8,0,0,0"/>
                                        <TextBox Text="{Binding SimulationPath, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="判定する共有内パス"/>
                                    </DockPanel>

                                    <StackPanel Visibility="{Binding HasSimulationResult, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Margin="0,0,0,6">
                                            <Run Text="正規化パス: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding SimulationResult.NormalizedPath}"/>
                                            <Run Text="   判定日時: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding SimulationResult.EvaluatedAt, Converter={StaticResource Utc}}"/>
                                        </TextBlock>
                                        <UniformGrid Columns="4">
                                            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="READ" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Read.ResultLabel}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Read.EvidenceLabel}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding SimulationResult.Read.MatchRule}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="WRITE" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Write.ResultLabel}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Write.EvidenceLabel}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding SimulationResult.Write.MatchRule}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="DELETE" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Delete.ResultLabel}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Delete.EvidenceLabel}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding SimulationResult.Delete.MatchRule}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <TextBlock Text="RENAME" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Rename.ResultLabel}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SimulationResult.Rename.EvidenceLabel}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                    <TextBlock Text="{Binding SimulationResult.Rename.MatchRule}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding SimulationWarningSummary}" Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
