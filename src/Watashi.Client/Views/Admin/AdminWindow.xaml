<Window x:Class="Watashi.Client.Views.Admin.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Watashi.Client.Views.Admin"
        Title="Watashi - 管理"
        Width="1220" Height="800" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="{StaticResource ToriiIcon}"
        Background="{StaticResource BgBrush}">
    <DockPanel LastChildFill="True">

        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource ToriiIcon}" Width="22" Height="22" Margin="0,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Watashi" Style="{StaticResource H3}" Margin="0,0,6,0"/>
                <TextBlock Text="／" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                <TextBlock Text="管理コンソール" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ===== Tabs (filling remaining area) ===== -->
        <TabControl x:Name="AdminTabs"
                    SelectionChanged="OnTabSelectionChanged"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="Transparent"
                    Padding="0,4,0,0">
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- 一覧に有限の高さを渡して仮想化を維持し、小画面では本文ごとスクロールする。 -->
                    <ScrollViewer x:Name="PageScroll"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  CanContentScroll="False" Focusable="False"
                                  AutomationProperties.Name="管理画面の本文">
                        <Grid MinWidth="900" MinHeight="600"
                              Width="{Binding ViewportWidth, ElementName=PageScroll}"
                              Height="{Binding ViewportHeight, ElementName=PageScroll}">
                            <ContentPresenter Content="{Binding}"/>
                        </Grid>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
            <TabItem Header="ユーザー">       <v:UserManagementView DataContext="{Binding Users}"/></TabItem>
            <TabItem Header="ホスト">        <v:HostManagementView DataContext="{Binding Hosts}"/></TabItem>
            <TabItem Header="共有">          <v:ShareManagementView DataContext="{Binding Shares}"/></TabItem>
            <TabItem Header="テンプレート">  <v:PermissionTemplateView DataContext="{Binding Templates}"/></TabItem>
            <TabItem Header="ユーザー権限">  <v:UserPermissionView DataContext="{Binding UserPermissions}"/></TabItem>
            <TabItem Header="権限セット">    <v:PermissionBundleView DataContext="{Binding Bundles}"/></TabItem>
            <TabItem Header="信頼デバイス">  <v:DeviceManagementView DataContext="{Binding Devices}"/></TabItem>
            <TabItem Header="実行ノード">    <v:NodeManagementView DataContext="{Binding Nodes}"/></TabItem>
            <TabItem Header="操作ログ">      <v:AuditLogView DataContext="{Binding Logs}"/></TabItem>
            <TabItem Header="運用状態">      <v:OperationsView DataContext="{Binding Operations}"/></TabItem>
            <TabItem Header="システム設定">  <v:SystemSettingsView DataContext="{Binding Settings}"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
