<Window x:Class="Watashi.Client.Views.Admin.AdminPathBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フォルダーを選択" Width="760" Height="640" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="{StaticResource ToriiIcon}" Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="フォルダーを選択" Style="{StaticResource H3}"/>
            <TextBlock Text="選択は元の許可パス欄に反映されます。権限の保存は元の画面で行ってください。"
                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <Label Content="参照するパス(_P)" Target="{Binding ElementName=BrowsePathBox}" Style="{StaticResource FieldLabel}"/>
            <DockPanel Margin="0,4,0,0">
                <Button Content="開く" Command="{Binding BrowseCommand}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBox x:Name="BrowsePathBox" Text="{Binding BrowsePath, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="参照するパス"/>
            </DockPanel>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding BrowseEntries}" SelectedItem="{Binding SelectedBrowseEntry}"
                 DisplayMemberPath="Name" AutomationProperties.Name="フォルダー一覧"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="許可パスに反映される値" Style="{StaticResource Caption}"/>
            <TextBox x:Name="SelectedPathBox" IsReadOnly="True" Margin="0,4,0,0"
                     AutomationProperties.Name="許可パスに反映される値"/>
            <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,6">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{Binding StatusMessage, Converter={StaticResource StatusBrush}}"/>
            </ScrollViewer>
            <Button Content="閉じて戻る" IsCancel="True" HorizontalAlignment="Right" MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>
