<Window x:Class="Watashi.Client.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力" Width="360" Height="160"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageLabel" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,8" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" IsDefault="True" Click="OnOk" Margin="0,0,5,0" />
            <Button Content="キャンセル" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
