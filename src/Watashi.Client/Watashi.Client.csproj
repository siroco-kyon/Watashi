<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Watashi.Shared\Watashi.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配布時設定。exe と同じ場所に出力され、ClickOnce 発行物にも含まれる。
      管理者が配布前に serverUrl / enableDragDrop を編集する (利用者は変更不可)。
      内容を変えたら再発行が必要 (ClickOnce マニフェストがハッシュ検証するため)。
    -->
    <Content Include="deployment.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CredentialManagement" Version="1.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.13" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      鳥居アイコン。Win32 リソースとして埋め込まれ、エクスプローラの exe アイコン、
      タスクバー、ClickOnce インストーラ画面、Add/Remove Programs などで使われる。
      ファイル自体は scripts/Generate-ToriiIcon.ps1 で生成 (16/24/32/48/64/128/256 multi-size)。
    -->
    <ApplicationIcon>Watashi.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
