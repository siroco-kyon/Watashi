<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Watashi.Shared\Watashi.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 廃止したリモートごみ箱の画面と ViewModel はビルド対象から除外する。 -->
    <Compile Remove="ViewModels\RemoteTrashViewModel.cs" />
    <Compile Remove="Views\RemoteTrashWindow.xaml.cs" />
    <Page Remove="Views\RemoteTrashWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      配布時設定。exe と同じ場所に出力され、ClickOnce 発行物にも含まれる。
      管理者が配布前に serverUrl / updateManifestUrl / enableDragDrop を編集する (利用者は変更不可)。
      内容を変えたら再発行が必要 (ClickOnce マニフェストがハッシュ検証するため)。
    -->
    <Content Include="deployment.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- BrandId をアセンブリに焼き込む。Services/Brand.cs が実行時に読み出す。 -->
    <AssemblyMetadata Include="BrandId" Value="$(BrandId)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CredentialManagement" Version="1.0.2" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.13" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <WatashiVersion Condition="'$(WatashiPublishVersion)' == ''">1.0.1</WatashiVersion>
    <WatashiVersion Condition="'$(WatashiPublishVersion)' != ''">$(WatashiPublishVersion)</WatashiVersion>
    <Version>$(WatashiVersion)</Version>
    <AssemblyVersion>$(WatashiVersion)</AssemblyVersion>
    <FileVersion>$(WatashiVersion)</FileVersion>
    <InformationalVersion>$(WatashiVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!--
      ローカル状態 (%LOCALAPPDATA% の設定/ログ、資格情報ターゲット) を分ける識別子。Services/Brand.cs が読む。
      A/B 版を同じ PC で共存させる場合のみ、発行時に版ごとの値を渡す:
        MSBuild.exe ... /p:BrandId=Watashi-b
      既定は Watashi。既存配布はこの値を変えないこと (変えると利用者の設定と自動ログインが失われる)。
      詳細は docs/BRANDING.md §7-4。
    -->
    <BrandId Condition="'$(BrandId)' == ''">Watashi</BrandId>
    <!--
      鳥居アイコン。Win32 リソースとして埋め込まれ、エクスプローラの exe アイコン、
      タスクバー、ClickOnce インストーラ画面、Add/Remove Programs などで使われる。
      ファイル自体は scripts/Generate-ToriiIcon.ps1 で生成 (16/24/32/48/64/128/256 multi-size)。
    -->
    <ApplicationIcon>Watashi.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
