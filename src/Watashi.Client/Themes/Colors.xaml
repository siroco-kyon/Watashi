<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ブラシ層。色の実値は Colors.Light.xaml / Colors.Dark.xaml が持ち、
        Services/ThemeManager.cs が Application.Resources のマージ辞書を差し替える。

        ここで Color を DynamicResource で引くのがテーマ切替の要になっている:
        辞書を差し替えても SolidColorBrush のインスタンス自体は同じまま Color だけが
        更新されるため、各画面は今までどおり {StaticResource XxxBrush} で掴んだままでよく、
        169 箇所の参照を書き換える必要がない。

        この仕組みが壊れるので、以下をやらないこと:
        - この辞書に配色ファイル (Colors.Light.xaml 等) をマージする
          (自分の辞書が先に検索され、テーマ切替が効かなくなる)
        - PresentationOptions:Freeze をブラシに付ける (凍結すると色を変更できない)
        - 画面側で {StaticResource XxxColor} と Color 値を直接参照する
          (構造体の値コピーになり、切替時に取り残される)
    -->

    <!-- ===== ベース ===== -->
    <SolidColorBrush x:Key="BgBrush"            Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{DynamicResource SurfaceHoverColor}" />

    <!-- ===== ボーダー ===== -->
    <SolidColorBrush x:Key="BorderBrush"        Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"  Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="FocusBrush"         Color="{DynamicResource FocusColor}" />

    <!-- ===== テキスト ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{DynamicResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{DynamicResource TextOnAccentColor}" />

    <!-- ===== アクセント (鳥居の朱色) ===== -->
    <SolidColorBrush x:Key="AccentBrush"        Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{DynamicResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush"    Color="{DynamicResource AccentDeepColor}" />

    <!-- ===== セカンダリ (深い藍/紺) ===== -->
    <SolidColorBrush x:Key="HeaderBrush"        Color="{DynamicResource HeaderColor}" />
    <SolidColorBrush x:Key="HeaderAltBrush"     Color="{DynamicResource HeaderAltColor}" />

    <!-- ===== ステータス ===== -->
    <SolidColorBrush x:Key="DangerBrush"        Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush"    Color="{DynamicResource DangerSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush"       Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush"       Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="InfoBrush"          Color="{DynamicResource InfoColor}" />

    <!-- ===== 角丸 ===== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

</ResourceDictionary>
