<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== ベース ===== -->
    <Color x:Key="BgColor">#F6F7F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F0F2F5</Color>
    <Color x:Key="SurfaceHoverColor">#EAEEF3</Color>
    <Color x:Key="OverlayColor">#0F1B2D</Color>

    <!-- ===== ボーダー ===== -->
    <Color x:Key="BorderColor">#D5D9DE</Color>
    <Color x:Key="BorderStrongColor">#9CA3AF</Color>
    <Color x:Key="FocusColor">#C73E1D</Color>

    <!-- ===== テキスト ===== -->
    <Color x:Key="TextPrimaryColor">#1F2328</Color>
    <Color x:Key="TextSecondaryColor">#4A535C</Color>
    <Color x:Key="TextMutedColor">#6B7280</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- ===== アクセント (鳥居の朱色) ===== -->
    <Color x:Key="AccentColor">#C73E1D</Color>
    <Color x:Key="AccentHoverColor">#A83216</Color>
    <Color x:Key="AccentPressedColor">#8C2911</Color>
    <Color x:Key="AccentSoftColor">#F9E5E0</Color>
    <Color x:Key="AccentDeepColor">#5C1A0B</Color>

    <!-- ===== セカンダリ (深い藍/紺) ===== -->
    <Color x:Key="HeaderColor">#1B2A41</Color>
    <Color x:Key="HeaderAltColor">#243B5C</Color>

    <!-- ===== ステータス ===== -->
    <Color x:Key="DangerColor">#CF222E</Color>
    <Color x:Key="DangerSoftColor">#FFE9EA</Color>
    <Color x:Key="WarningColor">#BF8700</Color>
    <Color x:Key="SuccessColor">#1F883D</Color>
    <Color x:Key="InfoColor">#0969DA</Color>

    <!-- ===== ブラシ ===== -->
    <SolidColorBrush x:Key="BgBrush"            Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush"  Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="FocusBrush"         Color="{StaticResource FocusColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush"  Color="{StaticResource TextOnAccentColor}" />

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentDeepBrush"    Color="{StaticResource AccentDeepColor}" />

    <SolidColorBrush x:Key="HeaderBrush"        Color="{StaticResource HeaderColor}" />
    <SolidColorBrush x:Key="HeaderAltBrush"     Color="{StaticResource HeaderAltColor}" />

    <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush"    Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}" />

    <!-- ===== 角丸 ===== -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>

</ResourceDictionary>
