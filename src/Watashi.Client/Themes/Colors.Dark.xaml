<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ベース -->
    <Color x:Key="BgColor">#0F1115</Color>
    <Color x:Key="SurfaceColor">#181B20</Color>
    <Color x:Key="SurfaceAltColor">#21252C</Color>
    <Color x:Key="SurfaceHoverColor">#2B3038</Color>
    <Color x:Key="OverlayColor">#05070A</Color>

    <!-- ボーダー -->
    <Color x:Key="BorderColor">#343A43</Color>
    <Color x:Key="BorderStrongColor">#687180</Color>
    <Color x:Key="FocusColor">#F0785B</Color>

    <!-- テキスト -->
    <Color x:Key="TextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#C8CED7</Color>
    <Color x:Key="TextMutedColor">#9BA5B2</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>

    <!-- アクセント。暗背景でも識別できるようライト版より明るくする。 -->
    <Color x:Key="AccentColor">#E15B3A</Color>
    <Color x:Key="AccentHoverColor">#F0785B</Color>
    <Color x:Key="AccentPressedColor">#C94728</Color>
    <Color x:Key="AccentSoftColor">#3A211C</Color>
    <Color x:Key="AccentDeepColor">#FFC1B1</Color>

    <!-- セカンダリ (深い藍/紺) -->
    <Color x:Key="HeaderColor">#121A28</Color>
    <Color x:Key="HeaderAltColor">#1B2A40</Color>

    <!-- ステータス -->
    <Color x:Key="DangerColor">#FF7B82</Color>
    <Color x:Key="DangerSoftColor">#3B1D21</Color>
    <Color x:Key="WarningColor">#E8B84A</Color>
    <Color x:Key="SuccessColor">#56D17A</Color>
    <Color x:Key="InfoColor">#6CB6FF</Color>

</ResourceDictionary>
