<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework">

    <!--
        ダークテーマの配色。キーは Colors.Light.xaml と 1:1 で対応させること。

        配色は「明度を反転しただけ」ではなく、暗い背景で読めるように選び直している。
        文字と背景の組み合わせは WCAG 2.1 AA (通常文字 4.5:1 / UI 部品 3:1) を満たし、
        tests/Watashi.Tests/ThemeContractTests.cs が hex 値から比率を計算して検証する。

        朱色 (鳥居のブランドカラー) は色相・彩度を保ったまま明度だけ上げている。
        暗い面の上で 3:1 を確保しつつ、その上に載る文字色 (TextOnAccentColor) を
        白から濃色へ反転させることで、ボタン文字のコントラストも AA を満たす。
    -->
    <!-- ===== ベース ===== -->
    <Color x:Key="BgColor">#14171A</Color>
    <Color x:Key="SurfaceColor">#1C2024</Color>
    <Color x:Key="SurfaceAltColor">#242A30</Color>
    <Color x:Key="SurfaceHoverColor">#2E353C</Color>
    <Color x:Key="OverlayColor">#05070A</Color>

    <!-- ===== ボーダー ===== -->
    <Color x:Key="BorderColor">#343B43</Color>
    <Color x:Key="BorderStrongColor">#5A646F</Color>
    <Color x:Key="FocusColor">#FF8A6B</Color>

    <!-- ===== テキスト ===== -->
    <Color x:Key="TextPrimaryColor">#E8EAED</Color>
    <Color x:Key="TextSecondaryColor">#BAC2CA</Color>
    <Color x:Key="TextMutedColor">#98A1AB</Color>
    <!-- 明るい朱の上に載るので、ライトテーマとは逆に濃色にする。 -->
    <Color x:Key="TextOnAccentColor">#1A0B06</Color>

    <!-- ===== アクセント (鳥居の朱色) ===== -->
    <Color x:Key="AccentColor">#E35B3B</Color>
    <Color x:Key="AccentHoverColor">#EA6F51</Color>
    <Color x:Key="AccentPressedColor">#D45130</Color>
    <Color x:Key="AccentSoftColor">#3A211A</Color>
    <!-- AccentSoft の上に置く文字色。ライトの濃朱に対し、ダークでは淡い朱になる。 -->
    <Color x:Key="AccentDeepColor">#FFB8A3</Color>

    <!-- ===== セカンダリ (深い藍/紺) ===== -->
    <Color x:Key="HeaderColor">#223550</Color>
    <Color x:Key="HeaderAltColor">#2C4468</Color>

    <!-- ===== ステータス ===== -->
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerSoftColor">#3A1D20</Color>
    <Color x:Key="WarningColor">#E3B341</Color>
    <Color x:Key="SuccessColor">#56D364</Color>
    <Color x:Key="InfoColor">#79B8FF</Color>

    <!--
        ===== システム色の上書き (ダークテーマ限定) =====

        WPF 既定テンプレートが内部で使う色。ComboBox のドロップダウン、ToolTip、
        テキスト選択範囲などはアプリ側でテンプレートを持っていないため、ここを
        上書きしないと暗い画面の中で白いままになる。

        ハイコントラストモードでは Controls.xaml の各 DataTrigger がこれらのキーを
        参照して OS の色へ切り替える。上書きするとその仕組みを壊すため、
        ThemeManager はハイコントラスト時にこの辞書を適用しない
        (常にライト配色 + OS のシステム色を使う)。
    -->
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.WindowBrushKey}"      Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.WindowTextBrushKey}"  Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.WindowFrameBrushKey}" Color="{StaticResource BorderColor}" />

    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.ControlBrushKey}"      Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.ControlTextBrushKey}"  Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.ControlLightBrushKey}" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.ControlDarkBrushKey}"  Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.GrayTextBrushKey}"     Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.HighlightBrushKey}"     Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.InactiveSelectionHighlightBrushKey}"     Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />

    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.MenuBrushKey}"          Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.MenuBarBrushKey}"       Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.MenuTextBrushKey}"      Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.MenuHighlightBrushKey}" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.InfoBrushKey}"     Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="{x:Static wpf:SystemColors.InfoTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />

</ResourceDictionary>
