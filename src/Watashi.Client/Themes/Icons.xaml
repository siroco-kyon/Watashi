            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#F06423" Stroke="#C7440C" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#FFD0B8"/>
                <TextBlock Text="P" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9" Canvas.Left="6" Canvas.Top="4"/>
                <Path Data="M7,15 L17,15 L17,20 L7,20 Z M12,15 L12,20" Stroke="White" StrokeThickness="1.1"/>
                <Ellipse Canvas.Left="13.5" Canvas.Top="15.5" Width="3" Height="3" Fill="White"/>
