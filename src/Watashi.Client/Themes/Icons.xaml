    </ControlTemplate>

    <ControlTemplate x:Key="ImageFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#F39A19" Stroke="#C56A00" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#FFE0A5"/>
                <Ellipse Canvas.Left="7" Canvas.Top="8" Width="3.2" Height="3.2" Fill="White"/>
                <Path Data="M6.5,19 L10.5,13.5 L13.2,16.5 L15.2,14 L18,19 Z" Fill="White"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ArchiveFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Border Canvas.Left="3" Canvas.Top="4" Width="18" Height="17" CornerRadius="3"
                        Background="#A96C3B" BorderBrush="#704020" BorderThickness="1.3"/>
                <Path Data="M3.8,10 L20.2,10" Stroke="#704020" StrokeThickness="1.2"/>
                <Path Data="M12,4 L12,14" Stroke="#F2E1CB" StrokeThickness="1.4" StrokeDashArray="1,1"/>
                <Border Canvas.Left="10.4" Canvas.Top="13" Width="3.2" Height="4.5" CornerRadius="1"
                        Background="#D9E0E4" BorderBrush="#596168" BorderThickness="0.7"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="TextCodeFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#66717D" Stroke="#414B55" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#C1C8CE"/>
                <TextBlock Text="&lt;/&gt;" Foreground="White" FontFamily="Consolas" FontWeight="Bold" FontSize="6.3" Canvas.Left="5.5" Canvas.Top="7"/>
                <Path Data="M7,16 L17,16 M7,19 L14.5,19" Stroke="White" StrokeThickness="1.2" StrokeStartLineCap="Round"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="AppFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Border Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" CornerRadius="3"
                        Background="#E43B3F" BorderBrush="#B21825" BorderThickness="1.3"/>
                <Path Data="M3.8,8 L20.2,8" Stroke="White" StrokeThickness="1.1"/>
                <Ellipse Canvas.Left="5.5" Canvas.Top="5" Width="1.4" Height="1.4" Fill="White"/>
                <Ellipse Canvas.Left="8.2" Canvas.Top="5" Width="1.4" Height="1.4" Fill="White"/>
                <Path Data="M8,13 L12,10.8 L16,13 L12,15.2 Z M8,13 L8,17 L12,19.2 L12,15.2 M16,13 L16,17 L12,19.2"
                      Stroke="White" StrokeThickness="1.1" StrokeLineJoin="Round" Fill="Transparent"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="DatabaseFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Rectangle Canvas.Left="5" Canvas.Top="6" Width="14" Height="12" Fill="#00A3A3"/>
                <Ellipse Canvas.Left="5" Canvas.Top="3" Width="14" Height="6" Fill="#24C3BF" Stroke="#007779" StrokeThickness="1.2"/>
                <Ellipse Canvas.Left="5" Canvas.Top="15" Width="14" Height="6" Fill="#009293" Stroke="#007779" StrokeThickness="1.2"/>
                <Path Data="M5,8 L5,17 C5,20 19,20 19,17 L19,8 M5,12 C5,15 19,15 19,12"
                      Stroke="White" StrokeThickness="1.1" Fill="Transparent"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="MediaFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#7C3CCF" Stroke="#51219A" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#D4B8F4"/>
                <Path Data="M8,8 L8,15 L14,11.5 Z" Fill="White"/>
                <TextBlock Text="♪" Foreground="White" FontFamily="Segoe UI Symbol" FontWeight="Bold" FontSize="8" Canvas.Left="12.5" Canvas.Top="13"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <!--
        ===== 鳥居アイコン (Torii) =====
        ViewBox: 64x64
        構成: 笠木 (kasagi) / 島木 (shimaki) / 柱 (hashira) x2 / 貫 (nuki)
        小さくしても識別できるよう、要素を太めにブロック化。
    -->
    <DrawingImage x:Key="ToriiIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64" />
                </DrawingGroup.ClipGeometry>

                <!-- 笠木 (top beam with upturned ends) -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry FillRule="Nonzero">
                            <PathFigure StartPoint="2,15" IsClosed="True">
                                <LineSegment Point="2,12" />
                                <BezierSegment Point1="2,4" Point2="6,2" Point3="14,5" />
                                <LineSegment Point="50,5" />
                                <BezierSegment Point1="58,2" Point2="62,4" Point3="62,12" />
                                <LineSegment Point="62,15" />
                                <LineSegment Point="2,15" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 島木 (second beam) -->
                <GeometryDrawing Brush="{StaticResource AccentDeepBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,17,52,5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 左柱 (left hashira, わずかに下に向かって広がる) -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="14,22" IsClosed="True">
                                <LineSegment Point="22,22" />
                                <LineSegment Point="23,60" />
                                <LineSegment Point="13,60" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 右柱 (right hashira) -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="42,22" IsClosed="True">
                                <LineSegment Point="50,22" />
                                <LineSegment Point="51,60" />
                                <LineSegment Point="41,60" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 貫 (nuki, 柱を貫く横木) -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="10,29,44,5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 反転バージョン (ヘッダー濃色背景用) -->
    <DrawingImage x:Key="ToriiIconLight">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,64,64" />
                </DrawingGroup.ClipGeometry>
                <GeometryDrawing Brush="{StaticResource TextOnAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="2,15" IsClosed="True">
                                <LineSegment Point="2,12" />
                                <BezierSegment Point1="2,4" Point2="6,2" Point3="14,5" />
                                <LineSegment Point="50,5" />
                                <BezierSegment Point1="58,2" Point2="62,4" Point3="62,12" />
                                <LineSegment Point="62,15" />
                                <LineSegment Point="2,15" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource TextOnAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,17,52,5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource TextOnAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="14,22" IsClosed="True">
                                <LineSegment Point="22,22" />
                                <LineSegment Point="23,60" />
                                <LineSegment Point="13,60" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource TextOnAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="42,22" IsClosed="True">
                                <LineSegment Point="50,22" />
                                <LineSegment Point="51,60" />
                                <LineSegment Point="41,60" />
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource TextOnAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="10,29,44,5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== 目玉アイコン (パスワード可視化トグル用) =====
        ViewBox: 24x24, パスワードの表示/非表示を切り替えるトグルボタンで使用。
        EyeIcon: パスワードが非表示の状態 (クリックすると見えるようになる)
        EyeOffIcon: パスワードが表示中の状態 (クリックすると隠れる)
    -->
    <DrawingImage x:Key="EyeIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,24,24"/>
                </DrawingGroup.ClipGeometry>
                <!-- 外形 (アーモンド型) -->
                <GeometryDrawing Brush="{StaticResource TextSecondaryBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry FillRule="EvenOdd">
                            <PathFigure StartPoint="2,12" IsClosed="True">
                                <BezierSegment Point1="5,5" Point2="9,3" Point3="12,3"/>
                                <BezierSegment Point1="15,3" Point2="19,5" Point3="22,12"/>
                                <BezierSegment Point1="19,19" Point2="15,21" Point3="12,21"/>
                                <BezierSegment Point1="9,21" Point2="5,19" Point3="2,12"/>
                            </PathFigure>
                            <PathFigure StartPoint="5.5,12" IsClosed="True">
                                <BezierSegment Point1="7.5,7.5" Point2="10,6" Point3="12,6"/>
                                <BezierSegment Point1="14,6" Point2="16.5,7.5" Point3="18.5,12"/>
                                <BezierSegment Point1="16.5,16.5" Point2="14,18" Point3="12,18"/>
                                <BezierSegment Point1="10,18" Point2="7.5,16.5" Point3="5.5,12"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 瞳 -->
                <GeometryDrawing Brush="{StaticResource TextSecondaryBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="2.6" RadiusY="2.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="EyeOffIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="0,0,24,24"/>
                </DrawingGroup.ClipGeometry>
                <!-- 外形 (薄め) -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry FillRule="EvenOdd">
                            <PathFigure StartPoint="2,12" IsClosed="True">
                                <BezierSegment Point1="5,5" Point2="9,3" Point3="12,3"/>
                                <BezierSegment Point1="15,3" Point2="19,5" Point3="22,12"/>
                                <BezierSegment Point1="19,19" Point2="15,21" Point3="12,21"/>
                                <BezierSegment Point1="9,21" Point2="5,19" Point3="2,12"/>
                            </PathFigure>
                            <PathFigure StartPoint="5.5,12" IsClosed="True">
                                <BezierSegment Point1="7.5,7.5" Point2="10,6" Point3="12,6"/>
                                <BezierSegment Point1="14,6" Point2="16.5,7.5" Point3="18.5,12"/>
                                <BezierSegment Point1="16.5,16.5" Point2="14,18" Point3="12,18"/>
                                <BezierSegment Point1="10,18" Point2="7.5,16.5" Point3="5.5,12"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 瞳 -->
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,12" RadiusX="2.6" RadiusY="2.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 斜め線 (eye-off の取り消し線) -->
                <GeometryDrawing Brush="{StaticResource SurfaceBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="-1,11,26,2">
                            <RectangleGeometry.Transform>
                                <RotateTransform Angle="-30" CenterX="12" CenterY="12"/>
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource AccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,11.5,24,1">
                            <RectangleGeometry.Transform>
                                <RotateTransform Angle="-30" CenterX="12" CenterY="12"/>
                            </RectangleGeometry.Transform>
                        </RectangleGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== ロゴテンプレート (Watashi 名前 + 鳥居) =====
    -->
    <ControlTemplate x:Key="ToriiLogo" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource ToriiIcon}" Width="22" Height="22" Margin="0,0,8,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Watashi" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

    <ControlTemplate x:Key="ToriiLogoLight" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource ToriiIconLight}" Width="22" Height="22" Margin="0,0,8,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Watashi" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextOnAccentBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </ControlTemplate>

</ResourceDictionary>
