<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ホーム画面のテーマ切り替え。どちらも 24x24 の輪郭アイコン。 -->
    <Geometry x:Key="MoonIconGeometry">M19,15.5 A8,8 0 0 1 8.5,5 A8,8 0 1 0 19,15.5 Z</Geometry>
    <Geometry x:Key="SunIconGeometry">M12,6 A6,6 0 1 1 12,18 A6,6 0 1 1 12,6 M12,1 L12,3 M12,21 L12,23 M1,12 L3,12 M21,12 L23,12 M4.2,4.2 L5.6,5.6 M18.4,18.4 L19.8,19.8 M19.8,4.2 L18.4,5.6 M5.6,18.4 L4.2,19.8</Geometry>

    <!-- ファイル一覧用。24x24 の同一グリッドで、小さい表示でも種類を判別できる形にそろえる。 -->
    <ControlTemplate x:Key="FolderFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M2.5,6.5 L9,6.5 L11,8.5 L21.5,8.5 L21.5,20.5 L2.5,20.5 Z"
                      Fill="#F6C343" Stroke="#C88900" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                <Path Data="M3.5,10.5 L20.5,10.5" Stroke="#FFF1B8" StrokeThickness="1.2"/>
            </Canvas>
        </Viewbox>
    </ControlTemplate>

    <ControlTemplate x:Key="ExcelFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
