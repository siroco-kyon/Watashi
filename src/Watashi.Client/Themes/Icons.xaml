    <ControlTemplate x:Key="PdfFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#D83B3E" Stroke="#A71D2A" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#F5B4B6"/>
                <Path Data="M7,12 C10,9 13,9 17,12 C14,11 10,13 7,16 C9,12 11,8 12,6 C12,10 14,15 17,17"
