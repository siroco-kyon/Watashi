                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#A9D1F5"/>
                <Path Data="M6.5,7 L8.2,13 L10.3,9 L12.4,13 L14.1,7" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/>
