                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#9BD5AE"/>
                <Path Data="M7,7 L12,13 M12,7 L7,13" Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M7,15.5 L17,15.5 L17,20 L7,20 Z M10.3,15.5 L10.3,20 M13.7,15.5 L13.7,20 M7,17.75 L17,17.75"
                      Stroke="White" StrokeThickness="0.8"/>
