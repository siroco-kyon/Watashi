    </ControlTemplate>

    <ControlTemplate x:Key="CsvFileIconTemplate" TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L15,2 L20,7 L20,22 L4,22 Z" Fill="#009CA6" Stroke="#00747B" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                <Path Data="M15,2 L20,7 L15,7 Z" Fill="#9BE0E3"/>
                <Path Data="M7,9 L17,9 L17,19 L7,19 Z M10.3,9 L10.3,19 M13.7,9 L13.7,19 M7,12.3 L17,12.3 M7,15.7 L17,15.7"
                      Stroke="White" StrokeThickness="0.9"/>
