{
  "ConnectionStrings": {
    "Default": "Data Source=C:\\ProgramData\\Watashi\\watashi.db;Cache=Shared;Foreign Keys=True;"
  },
  "Jwt": {
    "Secret": "CHANGE-ME-Watashi-Production-Secret-At-Least-32-Bytes-Long",
    "Issuer": "Watashi",
    "Audience": "Watashi",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Encryption": {
    "MasterKey": "REPLACE-WITH-BASE64-ENCODED-32-BYTE-KEY=="
  },
  "Auth": {
    "AllowHttpForAutoLogin": false,
    "LoginPerMinutePerIp": 10,
    "WindowsAuth": {
      "Mode": "IIS",
      "DomainMatch": "IgnoreDomain",
      "AllowedDomains": [],
      "EnableDiagnostics": true,
      "EnableSso": false,
      "SetupPerMinutePerIp": 30
    }
  },
  "Http": {
    "FileTransferTimeoutMinutes": 30
  },
  "TransferV2": {
    "SessionLifetimeHours": 24,
    "JanitorIntervalMinutes": 15,
    "CleanupGiveUpDays": 7,
    "MaxFileBytes": 10995116277760
  },
  "Routing": {
    "UseMtls": false,
    "UseProxy": false,
    "ClientCertificatePath": "",
    "ClientCertificatePassword": "",
    "SharedSecret": ""
  },
  "Cifs": {
    "SessionIdleSeconds": 60,
    "MaxSessionsPerKey": 4
  },
  "Operations": {
    "BackupDirectory": "C:\\ProgramData\\Watashi\\backups",
    "BackupMaxAgeHours": 26,
    "ExpiredTokenRetentionDays": 30,
    "DiskWarningBytes": 5368709120,
    "DiskCriticalBytes": 536870912,
    "CertificateWarningDays": 30
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10737418240
    },
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:8080" }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\Watashi\\logs\\server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
