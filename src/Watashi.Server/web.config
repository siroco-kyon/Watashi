<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS でホストする場合のリクエスト上限設定。

  IIS の requestFiltering/maxAllowedContentLength は ASP.NET Core 側の
  Kestrel:Limits:MaxRequestBodySize / IISServerOptions.MaxRequestBodySize とは
  「別レイヤ」で、リクエストがアプリに届く前段で効く。既定値は 30,000,000 byte
  (約 28.6 MB) で、これを超えるアップロードは HTTP 413
  (要求のエンティティが大きすぎる) で弾かれる。コード側で MaxRequestBodySize を
  10GB にしてもこの制限には効かないため、ここで明示的に引き上げる。

  注意: maxAllowedContentLength の型は uint のため、設定できる最大値は
  4,294,967,295 byte (約 4GB)。これが IIS ホスト時の実効アップロード上限になる。

  dotnet publish (Microsoft.NET.Sdk.Web) 時、ASP.NET Core Module の
  <aspNetCore> 要素・<handlers> はこのファイルへ自動的に注入されるため、
  この requestLimits 設定は publish 後の web.config にも維持される。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
